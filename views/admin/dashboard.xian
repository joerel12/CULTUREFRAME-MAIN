{{>head}}
<body class="cf-admin-body">
  {{>admin-sidebar}}

  <main class="cf-admin-main">
    <header class="cf-admin-topbar">
      <div>
        <h1>CultureFrame Control Center</h1>
        <p>Shared operations and connected-system access</p>
      </div>
      <span class="cf-status-pill">Main system online</span>
    </header>

    <div class="cf-admin-content">
      {{>messages}}

      <section class="cf-admin-hero">
        <div>
          <span class="cf-eyebrow" style="color:#cbed9b">Administrator workspace</span>
          <h2>One control center.<br/>Clear system ownership.</h2>
          <p>
            Monitor core operations here, then open the specialized system responsible for
            visitor content, seller products, payments or analytics.
          </p>
        </div>
        <div class="cf-admin-hero-mark" aria-hidden="true"><i class="fas fa-diagram-project"></i></div>
      </section>

      <section class="cf-stat-grid" aria-label="Operational statistics">
        <a href="/admin/orders" class="cf-stat-card">
          <div class="cf-stat-top"><span>All orders</span><span class="cf-stat-icon"><i class="fas fa-box"></i></span></div>
          <strong>{{orderCount}}</strong><span>Transactions in the main system</span>
        </a>
        <a href="/admin/orders" class="cf-stat-card">
          <div class="cf-stat-top"><span>Open orders</span><span class="cf-stat-icon"><i class="fas fa-clock"></i></span></div>
          <strong>{{openOrderCount}}</strong><span>Pending, processing or shipping</span>
        </a>
        <a href="/admin/customers" class="cf-stat-card">
          <div class="cf-stat-top"><span>Customers</span><span class="cf-stat-icon"><i class="fas fa-users"></i></span></div>
          <strong>{{customerCount}}</strong><span>Registered customer accounts</span>
        </a>
        <a href="/admin/sellers" class="cf-stat-card">
          <div class="cf-stat-top"><span>Sellers</span><span class="cf-stat-icon"><i class="fas fa-store"></i></span></div>
          <strong>{{sellerCount}}</strong><span>Marketplace seller profiles</span>
        </a>
      </section>

      <section class="cf-admin-grid">
        <div class="cf-panel">
          <div class="cf-panel-head">
            <div><h3>Connected systems</h3><p>Open the system that owns each module</p></div>
            <span class="cf-status-pill">Configured</span>
          </div>
          <div class="cf-service-list">
            {{#if visitorInformationUrl}}
              <a href="{{visitorInformationUrl}}" target="_blank" rel="noopener noreferrer" class="cf-service-card">
            {{else}}
              <a href="/discover" class="cf-service-card">
            {{/if}}
                <span class="cf-system-icon"><i class="fas fa-compass"></i></span>
                <span><strong>Visitor Information</strong><small>Heritage, traditions, events, attractions and published content</small></span>
                <i class="fas fa-arrow-up-right-from-square"></i>
              </a>

            <a href="/admin/sellers" class="cf-service-card">
              <span class="cf-system-icon gold"><i class="fas fa-basket-shopping"></i></span>
              <span><strong>Seller Workspace</strong><small>Seller access and product catalog ownership</small></span>
              <i class="fas fa-arrow-right"></i>
            </a>

            {{#if paymentSystemUrl}}
              <a href="{{paymentSystemUrl}}" target="_blank" rel="noopener noreferrer" class="cf-service-card">
                <span class="cf-system-icon coral"><i class="fas fa-credit-card"></i></span>
                <span><strong>CultureFrame Payments</strong><small>Payments, verification, refunds, receipts and payouts</small></span>
                <i class="fas fa-arrow-up-right-from-square"></i>
              </a>
            {{/if}}

            {{#if cultureMetricsSystemUrl}}
              <a href="{{cultureMetricsSystemUrl}}" target="_blank" rel="noopener noreferrer" class="cf-service-card">
                <span class="cf-system-icon blue"><i class="fas fa-chart-line"></i></span>
                <span><strong>CultureMetrics</strong><small>Revenue, customer, event and destination analytics</small></span>
                <i class="fas fa-arrow-up-right-from-square"></i>
              </a>
            {{/if}}
          </div>
        </div>

        <div class="cf-panel">
          <div class="cf-panel-head">
            <div><h3>Core actions</h3><p>Tasks retained by the main system</p></div>
          </div>
          <div class="cf-action-list">
            <a href="/admin/orders" class="cf-action-card"><i class="fas fa-box"></i><strong>Manage orders</strong></a>
            <a href="/admin/customers" class="cf-action-card"><i class="fas fa-users"></i><strong>Review customers</strong></a>
            <a href="/admin/sellers" class="cf-action-card"><i class="fas fa-store"></i><strong>Manage sellers</strong></a>
            <a href="/admin/feedbacks" class="cf-action-card"><i class="fas fa-star"></i><strong>Read feedback ({{feedbackCount}})</strong></a>
            <a href="/shop" class="cf-action-card"><i class="fas fa-basket-shopping"></i><strong>View marketplace</strong></a>
            <a href="/discover" class="cf-action-card"><i class="fas fa-compass"></i><strong>View Discover</strong></a>
          </div>
        </div>
      </section>
    </div>
  </main>
</body>
</html>
