{{>head}}
<body>
  {{>nav}}

  <main>
    <section class="cf-home-hero">
      <div class="cf-shell cf-hero-layout">
        <div>
          <span class="cf-hero-kicker"><span class="cf-live-dot"></span> Mansalay, Oriental Mindoro</span>
          <h1 class="cf-hero-title">Culture lives when it is <em>shared.</em></h1>
          <p class="cf-hero-copy">
            One connected platform for discovering living heritage, supporting local makers,
            managing cultural commerce, and understanding community impact.
          </p>
          <div class="cf-hero-actions">
            <a href="/discover" class="cf-button cf-button-primary">Start exploring <i class="fas fa-arrow-right"></i></a>
            <a href="/shop" class="cf-button cf-button-glass"><i class="fas fa-store"></i> Visit marketplace</a>
          </div>
          <div class="cf-hero-proof" aria-label="Connected community platform">
            <span class="cf-proof-stack" aria-hidden="true"><span>V</span><span>S</span><span>P</span><span>M</span></span>
            <span>Three role-based workspaces. One CultureFrame platform.</span>
          </div>
        </div>

        <div class="cf-ecosystem-board" aria-label="CultureFrame role-based workspaces">
          <div class="cf-board-top">
            <strong>Choose your workspace</strong>
            <span>One clear entry for every role</span>
          </div>
          <div class="cf-system-stack">
            <a href="/dashboard" class="cf-system-row">
              <span class="cf-system-icon"><i class="fas fa-compass"></i></span>
              <span class="cf-system-copy"><strong>Customer & Visitor</strong><span>One account for places, ratings, shopping and orders</span></span>
              <span class="cf-system-state">Unified</span>
            </a>
            <a href="/seller/dashboard" class="cf-system-row">
              <span class="cf-system-icon gold"><i class="fas fa-basket-shopping"></i></span>
              <span class="cf-system-copy"><strong>Seller Workspace</strong><span>Products, categories and marketplace inventory</span></span>
              <span class="cf-system-state">Role-based</span>
            </a>
            <a href="/admin/dashboard" class="cf-system-row">
              <span class="cf-system-icon coral"><i class="fas fa-shield-halved"></i></span>
              <span class="cf-system-copy"><strong>Admin Control Center</strong><span>Operations, visitor content, payments and CultureMetrics</span></span>
              <span class="cf-system-state">Admin-only</span>
            </a>
          </div>
        </div>
      </div>
      <p class="cf-beach-credit">
        Buktot Beach photo: <a href="https://commons.wikimedia.org/wiki/File:Buktot_Beach,_Mansalay_in_the_afternoon_(The_Wandering_Angel)_-_Flickr.jpg" target="_blank" rel="noopener noreferrer">The Wandering Angel</a>
        <span aria-hidden="true">·</span> <a href="https://creativecommons.org/licenses/by/2.0/" target="_blank" rel="noopener noreferrer">CC BY 2.0</a>
        <span aria-hidden="true">·</span> cropped for layout
      </p>
    </section>

    <section class="cf-shell cf-overlap" aria-label="Platform principles">
      <div class="cf-metric-strip">
        <div class="cf-metric"><strong>One portal</strong><span>Simple access for every role</span></div>
        <div class="cf-metric"><strong>Local first</strong><span>Built around Mansalay culture</span></div>
        <div class="cf-metric"><strong>Connected</strong><span>Shared data, clear ownership</span></div>
        <div class="cf-metric"><strong>Living archive</strong><span>Culture that keeps growing</span></div>
      </div>
    </section>

    {{#if destinations.length}}
    <section class="cf-section cf-destinations-section">
      <div class="cf-shell">
        <div class="cf-section-heading">
          <div>
            <span class="cf-eyebrow">Explore Mansalay</span>
            <h2>Beaches, nature, and cultural places worth discovering.</h2>
          </div>
          <p>These sourced destinations connect directly to the Visitor Information map and GPS-verified on-site feedback.</p>
        </div>
        <div class="cf-place-grid">
          {{#each destinations}}
          <article class="cf-place-card">
            <div class="cf-place-art">
              <img src="{{this.imageUrl}}" alt="{{this.imageAlt}}" loading="eager" decoding="async" onerror="this.onerror=null;this.src='/images/placeholders/record-placeholder.svg'" />
              <span>{{this.category}}</span>
              <i class="fas fa-location-dot" aria-hidden="true"></i>
              <small><i class="fas fa-shield-check"></i> GPS verified</small>
            </div>
            <div class="cf-place-body">
              <h3>{{this.name}}</h3>
              <p class="cf-place-address"><i class="fas fa-map-pin"></i>{{this.address}}</p>
              <p>{{this.description}}</p>
              <div class="cf-place-actions">
                <a href="{{this.feedbackUrl}}" class="cf-place-primary">Rate on site <i class="fas fa-arrow-right"></i></a>
                <a href="{{this.mapUrl}}" target="_blank" rel="noopener noreferrer">3D map</a>
              </div>
              {{#if this.imageUrl}}<p class="cf-card-credit">Image: <a href="{{this.imageSourceUrl}}" target="_blank" rel="noopener noreferrer">{{this.imageCredit}}</a>{{#if this.imageLicense}} · <a href="{{this.imageLicenseUrl}}" target="_blank" rel="noopener noreferrer">{{this.imageLicense}}</a>{{/if}}</p>{{/if}}
            </div>
          </article>
          {{/each}}
        </div>
        <div class="cf-destinations-footer"><a href="/discover/attractions" class="cf-button cf-button-outline">Explore all attractions <i class="fas fa-arrow-right"></i></a></div>
      </div>
    </section>
    {{/if}}

    <section class="cf-section">
      <div class="cf-shell">
        <div class="cf-section-heading">
          <div>
            <span class="cf-eyebrow">Choose your journey</span>
            <h2>Everything begins from one clear place.</h2>
          </div>
          <p>
            The main portal now focuses on access, identity, commerce and orchestration.
            Specialized teams manage their own modules without duplicate pages or conflicting records.
          </p>
        </div>

        <div class="cf-journey-grid">
          <a href="/discover/attractions" class="cf-journey-card">
            <span class="cf-journey-art cf-art-discover">
              <img src="https://www.travelorientalmindoro.ph/uploads/places/222/gallery/20251211053518_09274ecb.jpg" alt="Casabangan Beach and its forested Mansalay coastline" loading="eager" decoding="async" />
              <i class="fas fa-compass"></i><span class="cf-journey-photo-label">Casabangan Beach</span>
            </span>
            <small>Explore</small>
            <h3>Explore Mansalay's places</h3>
            <p>Plan responsible visits to white-sand beaches, eco trails, sacred sites and living heritage.</p>
            <span class="cf-card-arrow"><i class="fas fa-arrow-right"></i></span>
          </a>
          <a href="/shop" class="cf-journey-card">
            <span class="cf-journey-art cf-art-market">
              <img src="https://www.travelorientalmindoro.ph/uploads/places/488/gallery/20251212033811_fa20c30b.jpg" alt="A Hanunuo Mangyan artisan weaving in Barangay Panaytayan, Mansalay" loading="eager" decoding="async" />
              <i class="fas fa-basket-shopping"></i><span class="cf-journey-photo-label">Mangyan weaving</span>
            </span>
            <small>Support</small>
            <h3>Support Mangyan makers</h3>
            <p>Discover local craft and cultural products while supporting Mansalay sellers and artisan communities.</p>
            <span class="cf-card-arrow"><i class="fas fa-arrow-right"></i></span>
          </a>
          <a href="/discover/festivals" class="cf-journey-card">
            <span class="cf-journey-art cf-art-community">
              <img src="https://www.travelorientalmindoro.ph/uploads/events/10/gallery/20260209073544_cacbbcf1.png" alt="Mangyan Festival street dancers celebrating Mansalay's indigenous heritage" loading="eager" decoding="async" />
              <i class="fas fa-masks-theater"></i><span class="cf-journey-photo-label">Every November 25</span>
            </span>
            <small>Celebrate</small>
            <h3>Mangyan Festival</h3>
            <p>Experience indigenous dances, traditional crafts and heritage celebrations at Mansalay Municipal Grounds.</p>
            <span class="cf-card-arrow"><i class="fas fa-arrow-right"></i></span>
          </a>
        </div>
        <p class="cf-image-sources">Images: <a href="https://www.travelorientalmindoro.ph/place/casabangan-beach-marine-protected-areas" target="_blank" rel="noopener noreferrer">Casabangan Beach</a>, <a href="https://www.travelorientalmindoro.ph/place/mangyan-villages" target="_blank" rel="noopener noreferrer">Mangyan Villages</a>, and <a href="https://www.travelorientalmindoro.ph/festival/mangyan-festival" target="_blank" rel="noopener noreferrer">Mangyan Festival</a> · Travel Oriental Mindoro.</p>
      </div>
    </section>

    <section class="cf-shell pb-16">
      <div class="cf-platform-band">
        <div class="cf-platform-grid">
          <div>
            <span class="cf-eyebrow" style="color:#cbed9b">A coordinated platform</span>
            <h2>Five clear areas, without a fragmented experience.</h2>
            <p>
              The landing page leads to one Customer & Visitor side, one Seller side, and one Admin side.
              Payments stay inside checkout and order management, while CultureMetrics opens only from Admin.
            </p>
          </div>
          <a href="/register" class="cf-button cf-button-primary">Create your account <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>
    </section>
  </main>

  {{>footer}}
</body>
</html>
