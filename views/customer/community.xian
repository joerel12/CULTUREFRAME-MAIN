{{>head}}
<body class="bg-gray-50">
  {{>nav}}
  {{>messages}}

  <div class="max-w-4xl mx-auto px-4 pt-8">
    <div class="cf-page-header cf-fade-up">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <i class="fas fa-users text-emerald-200 text-sm"></i>
            <span class="text-emerald-200 text-sm font-medium">Social</span>
          </div>
          <h1 class="text-2xl font-extrabold text-white">Community Moments</h1>
          <p class="text-emerald-100 text-sm mt-0.5">Discover moments shared by the CultureFrame community</p>
        </div>
        {{#if isLoggedIn}}
        <a href="/customer/moment/new" class="cf-btn bg-white text-emerald-700 hover:bg-emerald-50 text-sm flex-shrink-0" style="border-radius:10px">
          <i class="fas fa-plus"></i> Post Moment
        </a>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-8 space-y-5">
    {{#if moments.length}}
      {{#each moments}}
      <div class="cf-card overflow-hidden cf-fade-up" id="post-{{this.id}}">
        <!-- Post header -->
        <div class="flex items-center justify-between px-5 pt-4 pb-3">
          <a href="/community/user/{{this.user_id}}" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
            {{#if this.userAvatar}}
            <img src="{{this.userAvatar}}" alt="{{this.userName}}"
                 class="w-9 h-9 rounded-full object-cover border-2 border-emerald-200" />
            {{else}}
            <div class="w-9 h-9 rounded-full bg-emerald-500 flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
              {{this.userName.[0]}}
            </div>
            {{/if}}
            <div>
              <p class="font-semibold text-gray-800 text-sm leading-none">{{this.userName}}</p>
              <p class="text-xs text-gray-400 mt-0.5">{{this.createdAt}}</p>
            </div>
          </a>

          <!-- Follow / Unfollow button -->
          {{#if isLoggedIn}}
            {{#unless this.isOwn}}
            <button
              class="follow-btn cf-btn text-xs px-3 py-1.5 {{#if this.isFollowing}}cf-btn-ghost following{{else}}cf-btn-primary{{/if}}"
              data-user-id="{{this.user_id}}"
              data-following="{{this.isFollowing}}">
              {{#if this.isFollowing}}
                <i class="fas fa-user-check"></i> Following
              {{else}}
                <i class="fas fa-user-plus"></i> Follow
              {{/if}}
            </button>
            {{/unless}}
          {{/if}}
        </div>

        <!-- Caption -->
        {{#if this.caption}}
        <div class="px-5 pb-3">
          <p class="text-gray-700 text-sm leading-relaxed">{{this.caption}}</p>
        </div>
        {{/if}}

        <!-- Image -->
        {{#if this.url}}
        <div class="bg-gray-100">
          <img src="{{this.url}}" alt="Moment by {{this.userName}}"
               class="w-full max-h-[480px] object-cover cursor-pointer"
               onclick="openLightbox('{{this.url}}')"
               onerror="this.parentElement.style.display='none'" />
        </div>
        {{/if}}

        <!-- Footer -->
        <div class="px-5 py-3 border-t border-gray-50 flex items-center justify-between">
          <a href="/community/user/{{this.user_id}}"
             class="text-xs text-emerald-600 hover:text-emerald-700 font-semibold transition-colors">
            View Profile →
          </a>
        </div>
      </div>
      {{/each}}
    {{else}}
    <div class="cf-card p-16 text-center cf-fade-up">
      <div class="w-20 h-20 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-camera text-emerald-400 text-3xl"></i>
      </div>
      <h3 class="text-xl font-extrabold text-gray-700 mb-2">No moments yet</h3>
      <p class="text-gray-400 text-sm mb-6">Be the first to share a moment with the community!</p>
      {{#if isLoggedIn}}
      <a href="/customer/moment/new" class="cf-btn cf-btn-primary">
        <i class="fas fa-plus"></i> Post First Moment
      </a>
      {{else}}
      <a href="/register" class="cf-btn cf-btn-primary">
        <i class="fas fa-user-plus"></i> Join Community
      </a>
      {{/if}}
    </div>
    {{/if}}
  </div>

  {{>footer}}

  <!-- Lightbox -->
  <div id="lightbox" class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4"
       onclick="this.classList.add('hidden')">
    <img id="lbImg" src="" alt="Full image"
         class="max-w-full max-h-[90vh] object-contain rounded-xl shadow-2xl" />
    <button onclick="document.getElementById('lightbox').classList.add('hidden')"
            class="absolute top-4 right-4 text-white bg-white/20 hover:bg-white/30 rounded-xl px-4 py-2 text-sm font-semibold">
      <i class="fas fa-xmark"></i> Close
    </button>
  </div>

  <script>
  function openLightbox(url) {
    document.getElementById('lbImg').src = url;
    document.getElementById('lightbox').classList.remove('hidden');
  }

  // Follow / Unfollow
  document.querySelectorAll('.follow-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const userId    = btn.dataset.userId;
      const following = btn.dataset.following === 'true';
      const method    = following ? 'DELETE' : 'POST';

      try {
        const res  = await fetch(`/follow/${userId}`, { method, headers: { 'Content-Type': 'application/json' } });
        const data = await res.json();
        if (data.success) {
          const nowFollowing = data.action === 'followed';
          btn.dataset.following = nowFollowing;
          if (nowFollowing) {
            btn.className = 'follow-btn cf-btn text-xs px-3 py-1.5 cf-btn-ghost following';
            btn.innerHTML = '<i class="fas fa-user-check"></i> Following';
          } else {
            btn.className = 'follow-btn cf-btn text-xs px-3 py-1.5 cf-btn-primary';
            btn.innerHTML = '<i class="fas fa-user-plus"></i> Follow';
          }
          // Update all other follow buttons for same user on this page
          document.querySelectorAll(`.follow-btn[data-user-id="${userId}"]`).forEach(b => {
            if (b !== btn) {
              b.dataset.following = nowFollowing;
              b.className = btn.className;
              b.innerHTML = btn.innerHTML;
            }
          });
        }
      } catch (e) {
        console.error('Follow error:', e);
      }
    });
  });
  </script>
</body>
</html>
