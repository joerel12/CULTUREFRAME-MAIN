{{>head}}
<body class="bg-gray-50">
  {{>nav}}
  {{>messages}}

  <div class="max-w-3xl mx-auto px-4 py-8">

    <!-- Profile card -->
    <div class="cf-card p-6 mb-6 cf-fade-up">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
        <!-- Avatar -->
        <div class="flex-shrink-0">
          {{#if profileUser.profileImage}}
          <img src="/uploads/{{profileUser.profileImage}}" alt="{{profileUser.name}}"
               class="w-24 h-24 rounded-2xl object-cover border-2 border-emerald-200 shadow" />
          {{else}}
          <div class="w-24 h-24 rounded-2xl bg-emerald-500 flex items-center justify-center text-white font-black text-4xl shadow">
            {{profileUser.name.[0]}}
          </div>
          {{/if}}
        </div>

        <!-- Info -->
        <div class="flex-1 text-center sm:text-left">
          <h1 class="text-2xl font-extrabold text-gray-800">{{profileUser.name}}</h1>
          <p class="text-gray-400 text-sm mt-0.5">Member since {{profileUser.createdAt}}</p>

          <!-- Stats -->
          <div class="flex gap-6 mt-3 justify-center sm:justify-start">
            <div class="text-center">
              <p class="text-xl font-extrabold text-gray-800">{{moments.length}}</p>
              <p class="text-xs text-gray-400">Moments</p>
            </div>
            <div class="text-center">
              <p class="text-xl font-extrabold text-gray-800" id="followersCount">{{followersCount}}</p>
              <p class="text-xs text-gray-400">Followers</p>
            </div>
            <div class="text-center">
              <p class="text-xl font-extrabold text-gray-800">{{followingCount}}</p>
              <p class="text-xs text-gray-400">Following</p>
            </div>
          </div>
        </div>

        <!-- Follow button -->
        {{#if isLoggedIn}}
          {{#unless isOwn}}
          <div class="flex-shrink-0">
            <button id="followBtn"
              class="cf-btn {{#if isFollowing}}cf-btn-ghost{{else}}cf-btn-primary{{/if}} px-6"
              data-user-id="{{profileUser.id}}"
              data-following="{{isFollowing}}">
              {{#if isFollowing}}
                <i class="fas fa-user-check"></i> Following
              {{else}}
                <i class="fas fa-user-plus"></i> Follow
              {{/if}}
            </button>
          </div>
          {{/unless}}
          {{#if isOwn}}
          <a href="/customer/profile/edit" class="cf-btn cf-btn-outline px-6 flex-shrink-0">
            <i class="fas fa-user-edit"></i> Edit Profile
          </a>
          {{/if}}
        {{/if}}
      </div>
    </div>

    <!-- Moments grid -->
    <div class="cf-fade-up cf-delay-1">
      <h2 class="font-bold text-gray-700 mb-4 flex items-center gap-2">
        <i class="fas fa-camera text-emerald-500 text-sm"></i> Moments
      </h2>

      {{#if moments.length}}
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {{#each moments}}
        <div class="relative group rounded-xl overflow-hidden border border-emerald-100 hover:border-emerald-300 transition-all aspect-square bg-gray-100">
          {{#if this.url}}
          <img src="{{this.url}}" alt="Moment"
               class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 cursor-pointer"
               onclick="openLightbox('{{this.url}}', '{{this.caption}}')"
               onerror="this.src='/images/logo.png'" />
          {{else}}
          <div class="w-full h-full flex items-center justify-center bg-emerald-50">
            <i class="fas fa-comment text-emerald-300 text-3xl"></i>
          </div>
          {{/if}}
          <!-- Caption overlay -->
          {{#if this.caption}}
          <div class="absolute bottom-0 left-0 right-0 bg-black/60 text-white p-2 text-xs opacity-0 group-hover:opacity-100 transition-opacity truncate">
            {{this.caption}}
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="cf-card p-12 text-center">
        <i class="fas fa-camera text-3xl text-gray-200 mb-3"></i>
        <p class="text-gray-400 text-sm">No moments posted yet.</p>
      </div>
      {{/if}}
    </div>

    <!-- Back to community -->
    <div class="mt-6 text-center">
      <a href="/community" class="cf-btn cf-btn-ghost text-sm">
        <i class="fas fa-arrow-left"></i> Back to Community
      </a>
    </div>
  </div>

  {{>footer}}

  <!-- Lightbox -->
  <div id="lightbox" class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-4"
       onclick="this.classList.add('hidden')">
    <div class="max-w-2xl w-full">
      <img id="lbImg" src="" alt="Full image"
           class="w-full max-h-[70vh] object-contain rounded-xl shadow-2xl mb-3" />
      <p id="lbCaption" class="text-white text-center text-sm opacity-80"></p>
    </div>
    <button onclick="document.getElementById('lightbox').classList.add('hidden')"
            class="absolute top-4 right-4 text-white bg-white/20 hover:bg-white/30 rounded-xl px-4 py-2 text-sm font-semibold">
      <i class="fas fa-xmark"></i> Close
    </button>
  </div>

  <script>
  function openLightbox(url, caption) {
    document.getElementById('lbImg').src = url;
    document.getElementById('lbCaption').textContent = caption || '';
    document.getElementById('lightbox').classList.remove('hidden');
  }

  // Follow / Unfollow
  const followBtn = document.getElementById('followBtn');
  if (followBtn) {
    followBtn.addEventListener('click', async () => {
      const userId    = followBtn.dataset.userId;
      const following = followBtn.dataset.following === 'true';
      const method    = following ? 'DELETE' : 'POST';
      try {
        const res  = await fetch(`/follow/${userId}`, { method, headers: { 'Content-Type': 'application/json' } });
        const data = await res.json();
        if (data.success) {
          const nowFollowing = data.action === 'followed';
          followBtn.dataset.following = nowFollowing;
          if (nowFollowing) {
            followBtn.className = 'cf-btn cf-btn-ghost px-6';
            followBtn.innerHTML = '<i class="fas fa-user-check"></i> Following';
          } else {
            followBtn.className = 'cf-btn cf-btn-primary px-6';
            followBtn.innerHTML = '<i class="fas fa-user-plus"></i> Follow';
          }
          // Update follower count
          const fc = document.getElementById('followersCount');
          if (fc) fc.textContent = data.followers;
        }
      } catch(e) { console.error(e); }
    });
  }
  </script>
</body>
</html>
