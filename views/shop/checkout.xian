{{>head}}
<body class="cf-checkout-page">
  {{>nav}}

  <main class="checkout-shell">
    <a class="checkout-back" href="/cart"><i class="fas fa-arrow-left"></i> Return to cart</a>

    <header class="checkout-heading">
      <div>
        <span class="checkout-kicker">Secure CultureFrame checkout</span>
        <h1>Complete your order</h1>
        <p>Review your local products, confirm delivery details, and submit payment evidence when paying online.</p>
      </div>
      <div class="checkout-steps" aria-label="Checkout progress">
        <span class="is-done">1 <small>Cart</small></span><i></i>
        <span class="is-active">2 <small>Checkout</small></span><i></i>
        <span>3 <small>Review</small></span>
      </div>
    </header>

    {{>messages}}

    <form method="POST" action="/order/create" id="checkoutForm" enctype="multipart/form-data" class="checkout-layout">
      <input type="hidden" name="cart_items" value='{{{serverCartJSON}}}' />

      <div class="checkout-main">
        <section class="checkout-card">
          <div class="checkout-card-title"><span>1</span><div><h2>Delivery details</h2><p>Use an address where the seller or courier can reach you.</p></div></div>
          <div class="checkout-fields two-columns">
            <label><span>Full name</span><input name="customer_name" value="{{customer_name}}" minlength="2" maxlength="100" required autocomplete="name" /></label>
            <label><span>Phone number</span><input name="customer_phone" value="{{customer_phone}}" maxlength="30" required autocomplete="tel" /></label>
          </div>
          <div class="checkout-fields stacked-fields">
            <label><span>Email address</span><input type="email" name="customer_email" value="{{customer_email}}" required autocomplete="email" /></label>
            <label><span>Complete shipping address</span><textarea name="shipping_address" rows="4" minlength="5" maxlength="250" required autocomplete="street-address">{{shipping_address}}</textarea></label>
          </div>
          <div class="delivery-note"><i class="fas fa-truck"></i><div><strong>Standard local delivery</strong><span>Shipping arrangements and the expected delivery date will be confirmed with your order.</span></div></div>
        </section>

        <section class="checkout-card">
          <div class="checkout-card-title"><span>2</span><div><h2>Payment method</h2><p>Online payments remain pending until an administrator verifies the evidence.</p></div></div>
          <div class="payment-options">
            <label class="payment-option is-selected"><input type="radio" name="payment_method" value="cash_on_delivery" checked /><span><b>Cash on delivery</b><small>Pay when the order arrives</small></span></label>
            <label class="payment-option"><input type="radio" name="payment_method" value="gcash" /><span><b>GCash</b><small>Provide a reference or receipt</small></span></label>
            <label class="payment-option"><input type="radio" name="payment_method" value="bank_transfer" /><span><b>Bank transfer</b><small>Provide a reference or receipt</small></span></label>
            <label class="payment-option"><input type="radio" name="payment_method" value="credit_card" /><span><b>Card payment</b><small>Provide a transaction reference</small></span></label>
          </div>

          <div class="payment-evidence is-cod" id="paymentEvidence">
            <div class="evidence-heading"><i class="fas fa-shield-halved"></i><div><h3 id="paymentEvidenceTitle">Cash on delivery</h3><p id="paymentEvidenceHelp">No advance proof is required. Payment will be collected when your order arrives.</p></div></div>
            <div class="online-payment-fields">
              <div class="checkout-fields two-columns">
                <label><span>Payment reference</span><input type="text" name="payment_reference" id="paymentReference" maxlength="100" placeholder="GCash, bank, or card reference" autocomplete="off" /></label>
                <label><span>Receipt or proof image</span><input type="file" name="payment_proof" id="paymentProof" accept="image/jpeg,image/png,image/webp" /></label>
              </div>
              <small class="proof-rule">Provide at least one: a reference of 6 or more characters, or a JPEG/PNG/WebP receipt up to 5 MB.</small>
            </div>
          </div>
        </section>

        <section class="checkout-card">
          <div class="checkout-card-title"><span>3</span><div><h2>Items in this order</h2><p>Product prices and stock are checked again by the server when you place the order.</p></div></div>
          <div class="checkout-products">
            {{#each cart}}
            <article>
              <img src="{{this.image_url}}" alt="{{this.name}}" loading="lazy" onerror="this.onerror=null;this.src='/images/products/ramit-textile.jpg'" />
              <div><h3>{{this.name}}</h3><p>Quantity: {{this.quantity}} <span>·</span> ₱{{this.price}} each</p></div>
              <strong>₱{{this.total}}</strong>
            </article>
            {{/each}}
          </div>
        </section>
      </div>

      <aside class="checkout-summary">
        <div class="checkout-card summary-card">
          <span class="checkout-kicker">Order summary</span>
          <h2>Ready for review</h2>
          <div class="summary-line"><span>Products</span><b>{{cart.length}} item(s)</b></div>
          <div class="summary-line"><span>Delivery</span><b>To be confirmed</b></div>
          <div class="summary-total"><span>Total</span><strong>₱{{cartTotal}}</strong></div>
          <button type="submit" id="placeOrderButton"><i class="fas fa-lock"></i> Place order securely</button>
          <p class="summary-security"><i class="fas fa-circle-check"></i> Online orders cannot be processed until payment evidence is approved. Uploaded receipts are private to the order owner and administrators.</p>
        </div>
      </aside>
    </form>
  </main>

  <style>
    .cf-checkout-page{margin:0;background:linear-gradient(135deg,#f7f6ef 0,#eef6f1 55%,#f7faf8 100%);color:#15241f;min-height:100vh}.checkout-shell{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:38px 0 70px}.checkout-back{display:inline-flex;align-items:center;gap:8px;color:#1b674f;font-weight:800;font-size:13px;text-decoration:none;margin-bottom:24px}.checkout-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:28px}.checkout-heading h1{font:600 clamp(34px,5vw,58px)/1.03 "Playfair Display",serif;margin:6px 0 10px;color:#11392e}.checkout-heading p{margin:0;color:#66776f;max-width:650px;line-height:1.65}.checkout-kicker{color:#197356;font:800 11px/1 "Manrope",sans-serif;letter-spacing:.14em;text-transform:uppercase}.checkout-steps{display:flex;align-items:center;flex-shrink:0}.checkout-steps>span{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:#dfe8e3;color:#718079;font:800 12px "Manrope",sans-serif;position:relative}.checkout-steps>span small{position:absolute;top:44px;left:50%;transform:translateX(-50%);font-size:9px;white-space:nowrap}.checkout-steps>span.is-done,.checkout-steps>span.is-active{background:#17694f;color:#fff}.checkout-steps>span.is-active{box-shadow:0 0 0 6px #cde6da}.checkout-steps>i{width:42px;height:2px;background:#cbd8d1}.checkout-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:24px;align-items:start}.checkout-main{display:grid;gap:20px}.checkout-card{background:#fff;border:1px solid #dce7e1;border-radius:22px;padding:26px;box-shadow:0 16px 44px rgba(17,57,46,.07)}.checkout-card-title{display:flex;align-items:flex-start;gap:14px;margin-bottom:22px}.checkout-card-title>span{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:#17694f;color:#fff;font:800 12px "Manrope",sans-serif;flex:0 0 auto}.checkout-card h2,.checkout-card h3{margin:0;color:#153a2f}.checkout-card-title h2{font:800 18px "Manrope",sans-serif}.checkout-card-title p{margin:5px 0 0;color:#77857e;font-size:12px}.checkout-fields{display:grid;gap:15px}.checkout-fields.two-columns{grid-template-columns:1fr 1fr}.stacked-fields{margin-top:15px}.checkout-fields label{display:grid;gap:7px;color:#3b5048;font-size:12px;font-weight:800}.checkout-fields input,.checkout-fields textarea{width:100%;border:1px solid #cedbd4;border-radius:12px;padding:12px 13px;background:#fbfdfc;color:#17271f;font:500 14px "DM Sans",sans-serif;outline:0}.checkout-fields input:focus,.checkout-fields textarea:focus{border-color:#248967;box-shadow:0 0 0 4px rgba(36,137,103,.12)}.delivery-note{display:flex;align-items:center;gap:13px;margin-top:17px;padding:14px;border-radius:14px;background:#edf8f3;color:#1b684f}.delivery-note>i{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:#fff}.delivery-note div{display:grid;gap:3px}.delivery-note strong{font-size:13px}.delivery-note span{font-size:11px;color:#5d756b}.payment-options{display:grid;grid-template-columns:1fr 1fr;gap:10px}.payment-option{display:flex;align-items:center;gap:11px;border:1px solid #d8e1dc;border-radius:14px;padding:14px;cursor:pointer;background:#fff;transition:.18s}.payment-option:hover,.payment-option.is-selected{border-color:#268563;background:#f0faf5;box-shadow:inset 0 0 0 1px #268563}.payment-option input{accent-color:#17694f}.payment-option span{display:grid;gap:3px}.payment-option b{font-size:13px}.payment-option small{font-size:10px;color:#72827a}.payment-evidence{margin-top:16px;padding:17px;border:1px solid #e4c776;border-radius:16px;background:#fff9e8}.evidence-heading{display:flex;gap:12px;align-items:flex-start}.evidence-heading>i{width:35px;height:35px;display:grid;place-items:center;border-radius:10px;background:#fff0bc;color:#7e5b08}.evidence-heading h3{font:800 14px "Manrope",sans-serif}.evidence-heading p{margin:4px 0 0;color:#766641;font-size:11px;line-height:1.5}.online-payment-fields{margin-top:15px}.payment-evidence.is-cod{border-color:#cce1d6;background:#f2faf6}.payment-evidence.is-cod .online-payment-fields{display:none}.proof-rule{display:block;margin-top:9px;color:#806c39;line-height:1.5}.checkout-products{display:grid;gap:10px}.checkout-products article{display:grid;grid-template-columns:62px minmax(0,1fr) auto;align-items:center;gap:14px;padding:11px;border:1px solid #e1e9e5;border-radius:14px}.checkout-products img{width:62px;height:62px;border-radius:11px;object-fit:cover;background:#edf4f0}.checkout-products h3{font:800 13px "Manrope",sans-serif}.checkout-products p{margin:6px 0 0;color:#79867f;font-size:11px}.checkout-products article>strong{color:#17694f;font-size:14px}.checkout-summary{position:sticky;top:92px}.summary-card{padding:28px;background:linear-gradient(155deg,#0f3d30,#17694f);color:#fff;border:0}.summary-card h2{color:#fff;font:600 28px "Playfair Display",serif;margin:8px 0 22px}.summary-card .checkout-kicker{color:#b9e2d0}.summary-line,.summary-total{display:flex;justify-content:space-between;gap:16px}.summary-line{padding:11px 0;border-bottom:1px solid rgba(255,255,255,.12);font-size:12px;color:#c8ded5}.summary-line b{color:#fff}.summary-total{align-items:end;padding:20px 0}.summary-total span{font-weight:800}.summary-total strong{font:600 28px "Playfair Display",serif;color:#f0c964}.summary-card button{width:100%;border:0;border-radius:13px;padding:14px;background:#efc65c;color:#17392f;font:800 13px "Manrope",sans-serif;cursor:pointer;box-shadow:0 10px 25px rgba(0,0,0,.16)}.summary-card button:hover{background:#f5d47e;transform:translateY(-1px)}.summary-card button:disabled{opacity:.65;cursor:wait}.summary-security{font-size:10px;line-height:1.55;color:#bdd5ca;margin:16px 0 0}.summary-security i{color:#efc65c;margin-right:5px}.checkout-toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);z-index:100;padding:12px 18px;border-radius:12px;background:#a62929;color:#fff;font-weight:800;font-size:12px;box-shadow:0 14px 36px rgba(0,0,0,.2)}
    @media(max-width:900px){.checkout-layout{grid-template-columns:1fr}.checkout-summary{position:static}.checkout-heading{align-items:flex-start;flex-direction:column}.checkout-steps{margin-bottom:16px}}
    @media(max-width:600px){.checkout-shell{width:min(100% - 20px,1180px);padding-top:24px}.checkout-card{padding:18px;border-radius:17px}.checkout-fields.two-columns,.payment-options{grid-template-columns:1fr}.checkout-heading h1{font-size:39px}.checkout-steps>i{width:25px}.checkout-products article{grid-template-columns:52px minmax(0,1fr)}.checkout-products img{width:52px;height:52px}.checkout-products article>strong{grid-column:2}}
  </style>

  <script>
    (() => {
      const form = document.getElementById('checkoutForm');
      const evidence = document.getElementById('paymentEvidence');
      const reference = document.getElementById('paymentReference');
      const proof = document.getElementById('paymentProof');
      const submitButton = document.getElementById('placeOrderButton');
      const showError = message => {
        document.querySelector('.checkout-toast')?.remove();
        const toast = document.createElement('div');
        toast.className = 'checkout-toast';
        toast.setAttribute('role', 'alert');
        toast.textContent = message;
        document.body.appendChild(toast);
        window.setTimeout(() => toast.remove(), 4500);
      };
      document.querySelectorAll('input[name="payment_method"]').forEach(input => {
        input.addEventListener('change', () => {
          document.querySelectorAll('.payment-option').forEach(option => option.classList.remove('is-selected'));
          input.closest('.payment-option').classList.add('is-selected');
          const isCod = input.value === 'cash_on_delivery';
          evidence.classList.toggle('is-cod', isCod);
          document.getElementById('paymentEvidenceTitle').textContent = isCod ? 'Cash on delivery' : 'Payment evidence required';
          document.getElementById('paymentEvidenceHelp').textContent = isCod
            ? 'No advance proof is required. Payment will be collected when your order arrives.'
            : 'Enter a valid transaction reference or upload a receipt. Your order stays pending until an administrator approves it.';
        });
      });
      form.addEventListener('submit', event => {
        const method = document.querySelector('input[name="payment_method"]:checked').value;
        if (method !== 'cash_on_delivery' && reference.value.trim().length < 6 && !proof.files.length) {
          event.preventDefault();
          showError('Enter a payment reference or upload proof of payment.');
          evidence.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting securely…';
      });
    })();
  </script>

  {{>footer}}
</body>
</html>
