{{>head}}
<body class="cart-body">
  {{>nav}}
  <main class="cart-shell">
    <header class="cart-heading">
      <div class="cart-heading-icon" aria-hidden="true">🛒</div>
      <div><span>CultureFrame marketplace</span><h1>Shopping cart</h1><p>Review your local products, choose what to order, and continue to secure checkout.</p></div>
      <a href="/shop" class="cart-continue">← Continue shopping</a>
    </header>

    {{#if error_msg}}<div class="cart-alert cart-alert-error" role="alert">{{error_msg}}</div>{{/if}}
    {{#if success_msg}}<div class="cart-alert cart-alert-success" role="status">{{success_msg}}</div>{{/if}}

    {{#if cart.length}}
    <div class="cart-layout">
      <section class="cart-panel" aria-label="Cart products">
        <div class="cart-panel-head">
          <label><input type="checkbox" id="selectAll" checked/> <span>Select all {{cart.length}} product(s)</span></label>
          <button type="button" id="removeSelected" class="cart-text-danger">Remove selected</button>
        </div>
        <div class="cart-products">
          {{#each cart}}
          <article class="cart-product" data-product-id="{{this.product_id}}" data-price="{{this.price}}">
            <input class="cart-checkbox item-checkbox" type="checkbox" checked data-product-id="{{this.product_id}}" aria-label="Select {{this.name}}"/>
            <img src="{{this.image_url}}" alt="{{this.name}}" loading="lazy" onerror="this.src='/images/products/ramit-textile.jpg'"/>
            <div class="cart-product-copy">
              <span>Local CultureFrame product</span>
              <h2>{{this.name}}</h2>
              <strong>₱{{this.price}}</strong>
            </div>
            <div class="cart-quantity" aria-label="Quantity for {{this.name}}">
              <button type="button" class="qty-change" data-step="-1" aria-label="Decrease quantity">−</button>
              <input class="qty-input" value="{{this.quantity}}" min="1" max="99" inputmode="numeric" aria-label="Quantity" readonly/>
              <button type="button" class="qty-change" data-step="1" aria-label="Increase quantity">+</button>
            </div>
            <div class="cart-line-total"><span>Item total</span><strong>₱{{this.total}}</strong></div>
            <form method="POST" action="/cart/remove">
              <input type="hidden" name="product_id" value="{{this.product_id}}"/>
              <button class="cart-remove" type="submit" aria-label="Remove {{this.name}}">×</button>
            </form>
          </article>
          {{/each}}
        </div>
      </section>

      <aside class="cart-summary">
        <div class="cart-summary-card">
          <span class="cart-summary-kicker">Order summary</span>
          <h2>Ready for checkout</h2>
          <dl>
            <div><dt>Selected products</dt><dd id="selectedCount">0</dd></div>
            <div><dt>Subtotal</dt><dd id="subtotal">₱0.00</dd></div>
            <div><dt>Shipping</dt><dd class="cart-free">Calculated at checkout</dd></div>
          </dl>
          <div class="cart-grand-total"><span>Total</span><strong id="totalAmount">₱0.00</strong></div>
          <form method="POST" action="/checkout" id="checkoutForm">
            <input type="hidden" name="selected_items" id="selectedItemsInput" value="[]"/>
            <button type="submit" id="checkoutBtn" class="cart-checkout">Proceed to secure checkout <span aria-hidden="true">→</span></button>
          </form>
          <p class="cart-secure-note">🔒 Checkout requires a signed-in customer account. Online payments also require a payment reference or proof.</p>
        </div>
        <div class="cart-help-card"><strong>Buying from local makers</strong><p>Your purchase helps CultureFrame connect cultural products with responsible local commerce.</p></div>
      </aside>
    </div>
    {{else}}
    <section class="cart-empty">
      <img src="/images/products/nito-basket.jpg" alt="Handwoven local basket"/>
      <div><span>Your cart is ready for discovery</span><h1>No products here yet.</h1><p>Browse Mangyan-inspired textiles, basketry, beadwork, and cultural learning keepsakes from local sellers.</p><a href="/shop">Explore the marketplace →</a></div>
    </section>
    {{/if}}
  </main>
  {{>footer}}

  <style>
    .cart-body{margin:0;background:linear-gradient(135deg,#f7f5ee,#edf6ef);color:#17382f;font-family:"DM Sans","Segoe UI",sans-serif}.cart-shell{width:min(1180px,calc(100% - 36px));margin:0 auto;padding:46px 0 80px}.cart-heading{display:grid;grid-template-columns:64px 1fr auto;align-items:center;gap:18px;margin-bottom:28px}.cart-heading-icon{width:64px;height:64px;display:grid;place-items:center;border-radius:19px;background:#123f34;font-size:26px;box-shadow:0 14px 30px #123f3428}.cart-heading span,.cart-summary-kicker,.cart-empty span{color:#a27525;font-size:10px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase}.cart-heading h1{margin:5px 0 3px;font:600 clamp(32px,4vw,48px)/1 "Playfair Display",Georgia,serif}.cart-heading p{margin:0;color:#718079;font-size:13px}.cart-continue{padding:11px 15px;border:1px solid #ceddd1;border-radius:99px;background:#ffffffb8;color:#285d49;font-size:11px;font-weight:800}.cart-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:24px;align-items:start}.cart-panel,.cart-summary-card,.cart-help-card,.cart-empty{border:1px solid #dce7dc;border-radius:23px;background:#fffffff0;box-shadow:0 18px 48px #173d3020}.cart-panel{overflow:hidden}.cart-panel-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px;border-bottom:1px solid #e2ebe2;background:#f6faf5}.cart-panel-head label{display:flex;align-items:center;gap:9px;font-size:12px;font-weight:800}.cart-panel-head input,.cart-checkbox{width:18px;height:18px;accent-color:#176348}.cart-text-danger{border:0;background:none;color:#b8483a;font-size:11px;font-weight:800;cursor:pointer}.cart-product{display:grid;grid-template-columns:20px 94px minmax(150px,1fr) auto 105px 36px;align-items:center;gap:16px;padding:20px 22px;border-bottom:1px solid #e9efe8}.cart-product:last-child{border-bottom:0}.cart-product>img{width:94px;height:94px;border-radius:16px;object-fit:cover;background:#e6eee5}.cart-product-copy>span{display:block;margin-bottom:5px;color:#8b998f;font-size:9px;font-weight:700;text-transform:uppercase}.cart-product-copy h2{margin:0 0 8px;font:600 20px/1.2 "Playfair Display",Georgia,serif}.cart-product-copy strong{color:#147252;font-size:16px}.cart-quantity{display:flex;align-items:center;border:1px solid #d7e3d8;border-radius:12px;overflow:hidden;background:#fff}.qty-change{width:34px;height:36px;border:0;background:#f1f7f1;color:#205843;font-size:18px;cursor:pointer}.qty-change:hover{background:#dcebdd}.qty-input{width:36px;height:36px;border:0;text-align:center;color:#17382f;font-size:12px;font-weight:800;outline:0}.cart-line-total{text-align:right}.cart-line-total span{display:block;color:#89968d;font-size:9px}.cart-line-total strong{display:block;margin-top:4px;color:#155f47;font-size:16px}.cart-remove{width:34px;height:34px;border:1px solid #f0c9c3;border-radius:10px;background:#fff4f2;color:#b94336;font-size:21px;cursor:pointer}.cart-summary{position:sticky;top:92px;display:grid;gap:14px}.cart-summary-card{padding:26px}.cart-summary-card h2{margin:7px 0 22px;font:600 28px "Playfair Display",Georgia,serif}.cart-summary dl{display:grid;gap:12px;margin:0;padding:0 0 17px;border-bottom:1px solid #e0e9df}.cart-summary dl>div{display:flex;justify-content:space-between;gap:15px;color:#708078;font-size:12px}.cart-summary dd{margin:0;color:#223f35;font-weight:800}.cart-free{font-size:10px}.cart-grand-total{display:flex;align-items:end;justify-content:space-between;margin:20px 0}.cart-grand-total span{font-size:13px;font-weight:800}.cart-grand-total strong{color:#126548;font:700 27px "Playfair Display",Georgia,serif}.cart-checkout{width:100%;display:flex;align-items:center;justify-content:center;gap:12px;padding:14px;border:0;border-radius:13px;background:linear-gradient(135deg,#0f5e46,#16805c);color:#fff;font-size:12px;font-weight:900;cursor:pointer;box-shadow:0 10px 24px #12654838}.cart-checkout:disabled{background:#a8b3ac;box-shadow:none;cursor:not-allowed}.cart-secure-note{margin:14px 0 0;color:#77867d;font-size:9px;line-height:1.6}.cart-help-card{padding:19px 21px;background:#143f35;color:#fff}.cart-help-card strong{font:600 17px "Playfair Display",Georgia,serif}.cart-help-card p{margin:7px 0 0;color:#bed1c5;font-size:10px;line-height:1.65}.cart-alert{margin:0 0 18px;padding:13px 16px;border-radius:12px;font-size:12px}.cart-alert-error{border:1px solid #efc1b9;background:#fff2ef;color:#963c31}.cart-alert-success{border:1px solid #b8ddc2;background:#effaf1;color:#22633a}.cart-empty{display:grid;grid-template-columns:minmax(260px,.8fr) 1.2fr;overflow:hidden}.cart-empty img{width:100%;height:100%;min-height:420px;object-fit:cover}.cart-empty>div{display:flex;flex-direction:column;justify-content:center;padding:clamp(34px,7vw,80px)}.cart-empty h1{margin:11px 0 15px;font:600 clamp(35px,5vw,56px)/1.05 "Playfair Display",Georgia,serif}.cart-empty p{max-width:500px;margin:0 0 26px;color:#6f7f76;font-size:13px;line-height:1.8}.cart-empty a{width:max-content;padding:13px 18px;border-radius:99px;background:#155f47;color:#fff;font-size:11px;font-weight:900}@media(max-width:950px){.cart-layout{grid-template-columns:1fr}.cart-summary{position:static}.cart-product{grid-template-columns:20px 76px 1fr auto}.cart-product>img{width:76px;height:76px}.cart-quantity{grid-column:3}.cart-line-total{grid-column:4;grid-row:2}.cart-product>form{grid-column:4;grid-row:1}}@media(max-width:620px){.cart-shell{width:min(100% - 22px,1180px);padding-top:26px}.cart-heading{grid-template-columns:50px 1fr}.cart-heading-icon{width:50px;height:50px}.cart-continue{grid-column:1/-1;width:max-content}.cart-panel-head{padding:14px}.cart-product{grid-template-columns:18px 68px 1fr;gap:10px;padding:15px 12px}.cart-product>img{width:68px;height:68px}.cart-product-copy h2{font-size:17px}.cart-quantity{grid-column:2/4;margin-top:4px;width:max-content}.cart-line-total{grid-column:3;grid-row:3}.cart-product>form{grid-column:1;grid-row:3}.cart-empty{grid-template-columns:1fr}.cart-empty img{height:230px;min-height:0}}
  </style>
  <script>
    (() => {
      const rows = [...document.querySelectorAll('.cart-product')];
      if (!rows.length) return;
      const all = document.getElementById('selectAll');
      const checkout = document.getElementById('checkoutBtn');
      const selectedInput = document.getElementById('selectedItemsInput');
      const money = value => `₱${Number(value).toLocaleString('en-PH',{minimumFractionDigits:2,maximumFractionDigits:2})}`;
      const recalculate = () => {
        const selected = rows.filter(row => row.querySelector('.item-checkbox').checked);
        const total = selected.reduce((sum,row) => sum + Number(row.dataset.price) * Number(row.querySelector('.qty-input').value),0);
        document.getElementById('selectedCount').textContent = String(selected.length);
        document.getElementById('subtotal').textContent = money(total);
        document.getElementById('totalAmount').textContent = money(total);
        selectedInput.value = JSON.stringify(selected.map(row => row.dataset.productId));
        checkout.disabled = selected.length === 0;
        all.checked = selected.length === rows.length;
        all.indeterminate = selected.length > 0 && selected.length < rows.length;
      };
      all.addEventListener('change', () => { rows.forEach(row => row.querySelector('.item-checkbox').checked = all.checked); recalculate(); });
      rows.forEach(row => {
        row.querySelector('.item-checkbox').addEventListener('change', recalculate);
        row.querySelectorAll('.qty-change').forEach(button => button.addEventListener('click', async () => {
          const input = row.querySelector('.qty-input');
          const next = Math.max(1, Math.min(99, Number(input.value) + Number(button.dataset.step)));
          if (next === Number(input.value)) return;
          input.value = String(next);
          row.querySelector('.cart-line-total strong').textContent = money(Number(row.dataset.price) * next);
          recalculate();
          const response = await fetch('/cart/update',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({product_id:row.dataset.productId,quantity:String(next)})});
          if (!response.ok) window.location.reload();
        }));
      });
      document.getElementById('removeSelected').addEventListener('click', async () => {
        const selected = rows.filter(row => row.querySelector('.item-checkbox').checked);
        if (!selected.length) return;
        if (!window.confirm(`Remove ${selected.length} selected product(s)?`)) return;
        for (const row of selected) await fetch('/cart/remove',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({product_id:row.dataset.productId})});
        window.location.reload();
      });
      recalculate();
    })();
  </script>
</body>
</html>
