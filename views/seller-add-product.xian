{{> seller-head}}
<body>
  <div class="cf-shell">
    {{> seller-sidebar}}
    <div class="cf-main">
      {{> seller-topbar}}
      <main class="cf-page">

        <!-- ── Page header ─────────────────────────────────────────── -->
        <div class="cf-page-header">
          <div class="cf-page-header-inner">
            <div>
              <p class="cf-page-eyebrow">Product Management</p>
              <h1 class="cf-page-title">Add Product</h1>
              <p class="cf-page-sub">List a new cultural heritage product</p>
            </div>
            <a href="/seller/products" class="cf-link-btn" style="align-self:center;">← Back to Products</a>
          </div>
          <div class="cf-weave-divider" aria-hidden="true"></div>
        </div>

        <!-- ── Database error banner ──────────────────────────────── -->
        {{#if dbError}}
          <div style="background:#FFF3E0;border:1px solid #FFCC80;border-radius:10px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:flex-start;gap:12px;" role="alert">
            <span style="font-size:20px;flex-shrink:0;">⚠️</span>
            <div>
              <p style="font-weight:700;color:#E65100;margin:0 0 4px;font-size:14px;">Database Error</p>
              <p style="color:#BF360C;font-size:13px;margin:0;">{{dbError}}</p>
            </div>
          </div>
        {{/if}}

        <!-- ── Form card ───────────────────────────────────────────── -->
        <div style="background:var(--white);border-radius:var(--radius-lg);box-shadow:var(--shadow-sm);border:1px solid var(--cream-dark);padding:32px;max-width:780px;">

          <!-- Validation error list -->
          {{#if fieldErrors.length}}
            <div style="background:#FFF3E0;border:1px solid #FFCC80;border-radius:8px;padding:14px 18px;margin-bottom:24px;" role="alert" aria-live="polite">
              <p style="font-weight:700;color:#E65100;margin:0 0 8px;font-size:14px;display:flex;align-items:center;gap:6px;">
                ⚠️ Please fix the following before saving:
              </p>
              <ul style="margin:0;padding-left:18px;">
                {{#each fieldErrors}}
                  <li style="color:#BF360C;font-size:13px;margin-bottom:3px;">{{this}}</li>
                {{/each}}
              </ul>
            </div>
          {{/if}}

          <!-- Success flash -->
          {{#if success_msg}}
            <div style="background:var(--green-pale);border:1px solid #A5C5A5;border-radius:8px;padding:14px 18px;margin-bottom:24px;" role="status">
              <p style="color:var(--green);font-weight:700;font-size:14px;margin:0;">✅ {{success_msg}}</p>
            </div>
          {{/if}}

          <!--
            enctype="multipart/form-data" is required for file upload.
            The multer middleware on the POST route reads this.
          -->
          <form action="/seller/products/add" method="POST" enctype="multipart/form-data" id="addProductForm" novalidate>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">

              <!-- ── Product Name ─────────────────────────────────── -->
              <div style="grid-column:1/-1;">
                <label for="name" style="display:block;font-size:13px;font-weight:600;color:var(--text-mid);margin-bottom:6px;">
                  Product Name <span style="color:var(--terra);" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  value="{{old.name}}"
                  placeholder="e.g. Mangyan Woven Basket"
                  maxlength="200"
                  required
                  aria-required="true"
                  style="width:100%;padding:10px 14px;border:1px solid var(--cream-dark);border-radius:8px;font-size:14px;color:var(--text-dark);background:var(--cream);outline:none;transition:border-color 0.18s;"
                  onfocus="this.style.borderColor='var(--terra)'"
                  onblur="this.style.borderColor='var(--cream-dark)'"
                />
              </div>

              <!-- ── Category ────────────────────────────────────── -->
              <div>
                <label for="category" style="display:block;font-size:13px;font-weight:600;color:var(--text-mid);margin-bottom:6px;">
                  Category <span style="color:var(--terra);" aria-hidden="true">*</span>
                </label>
                <select
                  id="category"
                  name="category"
                  required
                  aria-required="true"
                  style="width:100%;padding:10px 14px;border:1px solid var(--cream-dark);border-radius:8px;font-size:14px;color:var(--text-dark);background:var(--cream);outline:none;appearance:none;transition:border-color 0.18s;"
                  onfocus="this.style.borderColor='var(--terra)'"
                  onblur="this.style.borderColor='var(--cream-dark)'"
                >
                  <option value="" disabled {{#unless old.category}}selected{{/unless}}>Select a category</option>
                  {{#each categories}}
                    <option value="{{this.id}}" {{#if (eq this.id ../old.category)}}selected{{/if}}>{{this.name}}</option>
                  {{/each}}
                  {{#unless categories.length}}
                    <option disabled>No categories available</option>
                  {{/unless}}
                </select>
              </div>

              <!-- ── Status ─────────────────────────────────────── -->
              <div>
                <label for="status" style="display:block;font-size:13px;font-weight:600;color:var(--text-mid);margin-bottom:6px;">
                  Status <span style="color:var(--terra);" aria-hidden="true">*</span>
                </label>
                <select
                  id="status"
                  name="status"
                  required
                  style="width:100%;padding:10px 14px;border:1px solid var(--cream-dark);border-radius:8px;font-size:14px;color:var(--text-dark);background:var(--cream);outline:none;appearance:none;transition:border-color 0.18s;"
                  onfocus="this.style.borderColor='var(--terra)'"
                  onblur="this.style.borderColor='var(--cream-dark)'"
                >
                  <!--
                    "active"   = Published  (visible on storefront)
                    "inactive" = Draft      (hidden until ready)
                  -->
                  <option value="active"   {{#if (eq old.status "active")}}selected{{/if}}
                    {{#unless old.status}}selected{{/unless}}>
                    Published
                  </option>
                  <option value="inactive" {{#if (eq old.status "inactive")}}selected{{/if}}>
                    Draft
                  </option>
                </select>
                <p style="font-size:11px;color:var(--text-muted);margin:5px 0 0 2px;">
                  Published = visible to buyers. Draft = saved but hidden.
                </p>
              </div>

              <!-- ── Price ──────────────────────────────────────── -->
              <div>
                <label for="price" style="display:block;font-size:13px;font-weight:600;color:var(--text-mid);margin-bottom:6px;">
                  Price (₱) <span style="color:var(--terra);" aria-hidden="true">*</span>
                </label>
                <div style="position:relative;">
                  <span style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:13px;font-weight:600;pointer-events:none;">₱</span>
                  <input
                    type="number"
                    id="price"
                    name="price"
                    value="{{old.price}}"
                    placeholder="0.00"
                    min="0"
                    max="99999999.99"
                    step="0.01"
                    required
                    aria-required="true"
                    style="width:100%;padding:10px 14px 10px 26px;border:1px solid var(--cream-dark);border-radius:8px;font-size:14px;color:var(--text-dark);background:var(--cream);outline:none;transition:border-color 0.18s;"
                    onfocus="this.style.borderColor='var(--terra)'"
                    onblur="this.style.borderColor='var(--cream-dark)'"
                  />
                </div>
              </div>

              <!-- ── Stock Quantity ─────────────────────────────── -->
              <div>
                <label for="stock" style="display:block;font-size:13px;font-weight:600;color:var(--text-mid);margin-bottom:6px;">
                  Stock Quantity
                </label>
                <input
                  type="number"
                  id="stock"
                  name="stock"
                  value="{{old.stock}}"
                  placeholder="0"
                  min="0"
                  style="width:100%;padding:10px 14px;border:1px solid var(--cream-dark);border-radius:8px;font-size:14px;color:var(--text-dark);background:var(--cream);outline:none;transition:border-color 0.18s;"
                  onfocus="this.style.borderColor='var(--terra)'"
                  onblur="this.style.borderColor='var(--cream-dark)'"
                />
              </div>

              <!-- ── Description ───────────────────────────────── -->
              <div style="grid-column:1/-1;">
                <label for="description" style="display:block;font-size:13px;font-weight:600;color:var(--text-mid);margin-bottom:6px;">
                  Description
                </label>
                <textarea
                  id="description"
                  name="description"
                  rows="4"
                  placeholder="Describe the cultural significance, materials, and origin of this product…"
                  style="width:100%;padding:10px 14px;border:1px solid var(--cream-dark);border-radius:8px;font-size:14px;color:var(--text-dark);background:var(--cream);outline:none;resize:vertical;transition:border-color 0.18s;"
                  onfocus="this.style.borderColor='var(--terra)'"
                  onblur="this.style.borderColor='var(--cream-dark)'"
                >{{old.description}}</textarea>
              </div>

              <!-- ── Product Image ─────────────────────────────── -->
              <div style="grid-column:1/-1;">
                <label for="image" style="display:block;font-size:13px;font-weight:600;color:var(--text-mid);margin-bottom:6px;">
                  Product Image
                </label>

                <!-- Preview box -->
                <div
                  id="imagePreviewBox"
                  style="width:100%;height:180px;border:2px dashed var(--cream-dark);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;background:var(--cream);transition:border-color 0.2s;margin-bottom:10px;overflow:hidden;position:relative;"
                  onclick="document.getElementById('image').click()"
                >
                  <img
                    id="imagePreview"
                    src=""
                    alt="Preview"
                    style="display:none;width:100%;height:100%;object-fit:cover;border-radius:8px;"
                  />
                  <div id="imagePlaceholder" style="text-align:center;pointer-events:none;">
                    <span style="font-size:32px;display:block;margin-bottom:8px;">🖼️</span>
                    <p style="color:var(--text-muted);font-size:13px;margin:0;">Click to choose an image</p>
                    <p style="color:var(--text-muted);font-size:11px;margin:4px 0 0;">JPEG, PNG or WebP · Max 3 MB</p>
                  </div>
                </div>

                <input
                  type="file"
                  id="image"
                  name="image"
                  accept="image/jpeg,image/png,image/webp"
                  style="display:none;"
                />
                <p id="imageError" style="color:#C62828;font-size:12px;margin:4px 0 0;display:none;"></p>
              </div>

            </div><!-- /grid -->

            <!-- ── Submit row ──────────────────────────────────── -->
            <div style="display:flex;gap:12px;margin-top:28px;padding-top:20px;border-top:1px dashed var(--cream-dark);flex-wrap:wrap;">
              <button
                type="submit"
                id="submitBtn"
                style="background:var(--terra);color:#fff;border:none;border-radius:8px;padding:11px 28px;font-size:14px;font-weight:700;cursor:pointer;transition:background 0.18s;"
                onmouseover="this.style.background='var(--terra-light)'"
                onmouseout="this.style.background='var(--terra)'"
              >
                Save Product
              </button>
              <a
                href="/seller/products"
                style="background:var(--cream-dark);color:var(--text-mid);border-radius:8px;padding:11px 24px;font-size:14px;font-weight:600;display:inline-flex;align-items:center;transition:background 0.18s;"
                onmouseover="this.style.background='#e0d5c4'"
                onmouseout="this.style.background='var(--cream-dark)'"
              >
                Cancel
              </a>
            </div>

          </form><!-- /form -->
        </div><!-- /card -->

        <!-- ── Client-side validation + image preview ─────────────── -->
        <script>
        (function () {
          var fileInput    = document.getElementById('image');
          var preview      = document.getElementById('imagePreview');
          var placeholder  = document.getElementById('imagePlaceholder');
          var imageError   = document.getElementById('imageError');
          var previewBox   = document.getElementById('imagePreviewBox');
          var form         = document.getElementById('addProductForm');
          var submitBtn    = document.getElementById('submitBtn');

          var ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
          var MAX_BYTES     = 3 * 1024 * 1024;

          // ── Image preview & client-side file validation ──────────
          fileInput.addEventListener('change', function () {
            var file = this.files[0];
            imageError.style.display = 'none';
            imageError.textContent   = '';

            if (!file) {
              preview.style.display     = 'none';
              placeholder.style.display = 'block';
              return;
            }

            if (!ALLOWED_TYPES.includes(file.type)) {
              imageError.textContent   = 'Only JPEG, PNG, or WebP images are accepted.';
              imageError.style.display = 'block';
              this.value               = '';
              preview.style.display    = 'none';
              placeholder.style.display = 'block';
              return;
            }

            if (file.size > MAX_BYTES) {
              imageError.textContent   = 'Image must be 3 MB or smaller.';
              imageError.style.display = 'block';
              this.value               = '';
              preview.style.display    = 'none';
              placeholder.style.display = 'block';
              return;
            }

            var reader = new FileReader();
            reader.onload = function (e) {
              preview.src               = e.target.result;
              preview.style.display     = 'block';
              placeholder.style.display = 'none';
              previewBox.style.borderColor = 'var(--terra)';
            };
            reader.readAsDataURL(file);
          });

          // ── Client-side form validation ──────────────────────────
          form.addEventListener('submit', function (e) {
            var errors = [];

            var name  = document.getElementById('name').value.trim();
            var price = parseFloat(document.getElementById('price').value);
            var stock = document.getElementById('stock').value;
            var cat   = document.getElementById('category').value;

            if (!name || name.length < 2)
              errors.push('Product name is required (minimum 2 characters).');
            if (!cat)
              errors.push('Please select a category.');
            if (document.getElementById('price').value === '' || isNaN(price))
              errors.push('Price is required.');
            else if (price < 0)
              errors.push('Price cannot be negative.');
            if (stock !== '' && parseInt(stock, 10) < 0)
              errors.push('Stock quantity cannot be negative.');

            if (errors.length > 0) {
              e.preventDefault();
              var box = document.createElement('div');
              box.setAttribute('role', 'alert');
              box.style.cssText = 'background:#FFF3E0;border:1px solid #FFCC80;border-radius:8px;padding:14px 18px;margin-bottom:20px;';
              box.innerHTML = '<p style="font-weight:700;color:#E65100;margin:0 0 8px;font-size:14px;">⚠️ Please fix the following:</p><ul style="margin:0;padding-left:18px;">'
                + errors.map(function(e){ return '<li style="color:#BF360C;font-size:13px;margin-bottom:3px;">'+e+'</li>'; }).join('')
                + '</ul>';
              var existing = form.querySelector('[role="alert"]');
              if (existing) existing.remove();
              form.insertBefore(box, form.firstChild);
              window.scrollTo({ top: 0, behavior: 'smooth' });
              return;
            }

            // Disable button to prevent double-submit
            submitBtn.disabled    = true;
            submitBtn.textContent = 'Saving…';
          });
        })();
        </script>

{{> seller-footer}}
