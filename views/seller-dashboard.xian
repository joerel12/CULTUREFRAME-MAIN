{{> seller-head}}
<body>
  <div class="cf-shell">
    {{> seller-sidebar}}
    <div class="cf-main">
      {{> seller-topbar}}
      <main class="cf-page">

        <!-- ── Page header ─────────────────────────────────────────── -->
        <div class="cf-page-header">
          <div class="cf-page-header-inner">
            <div>
              <p class="cf-page-eyebrow">Seller Dashboard</p>
              <h1 class="cf-page-title">Overview</h1>
              <p class="cf-page-sub">Your product management summary</p>
            </div>
          </div>
          <div class="cf-weave-divider" aria-hidden="true"></div>
        </div>

        <!-- ── Database error banner ──────────────────────────────── -->
        {{#if dbError}}
          <div style="background:#FFF3E0;border:1px solid #FFCC80;border-radius:10px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:flex-start;gap:12px;" role="alert">
            <span style="font-size:20px;flex-shrink:0;">⚠️</span>
            <div>
              <p style="font-weight:700;color:#E65100;margin:0 0 4px;font-size:14px;">Database Error</p>
              <p style="color:#BF360C;font-size:13px;margin:0;">{{dbError}}</p>
            </div>
          </div>
        {{/if}}

        <!-- ── Flash messages ─────────────────────────────────────── -->
        {{#if success_msg}}
          <div style="background:var(--green-pale);border:1px solid #A5C5A5;border-radius:10px;padding:14px 20px;margin-bottom:20px;display:flex;align-items:center;gap:12px;" role="status">
            <span style="font-size:18px;flex-shrink:0;">✅</span>
            <p style="color:var(--green);font-weight:600;font-size:14px;margin:0;">{{success_msg}}</p>
          </div>
        {{/if}}

        <!-- ── Welcome banner ─────────────────────────────────────── -->
        <div class="cf-welcome">
          <div class="cf-welcome-art" aria-hidden="true">🏺</div>
          <div class="cf-welcome-content">
            <h2 class="cf-welcome-title">Welcome to your Seller Dashboard</h2>
            <p class="cf-welcome-sub">
              Manage your cultural heritage products for the Mansalay community marketplace.
            </p>
            <div class="cf-welcome-chips">
              <span class="cf-chip">🏛️ Cultural Heritage</span>
              <span class="cf-chip">🌿 Mansalay, Oriental Mindoro</span>
              <span class="cf-chip">🧵 Traditional Crafts</span>
            </div>
          </div>
        </div>

        <!-- ── Summary cards ──────────────────────────────────────── -->
        <div class="cf-cards">

          <!-- Total Products -->
          <div class="cf-card cf-card--terra">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--terra" aria-hidden="true">🏺</div>
              <span class="cf-card-badge cf-card-badge--info">Total</span>
            </div>
            <div class="cf-card-value">{{totalProducts}}</div>
            <div class="cf-card-label">Total Products</div>
            <div class="cf-card-hint">
              {{#if totalProducts}}
                All products in your catalogue.
              {{else}}
                No products yet. <a href="/seller/products/add" style="color:var(--terra);font-weight:600;">Add one now.</a>
              {{/if}}
            </div>
          </div>

          <!-- Published -->
          <div class="cf-card cf-card--green">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--green" aria-hidden="true">✅</div>
              <span class="cf-card-badge cf-card-badge--ok">Published</span>
            </div>
            <div class="cf-card-value">{{publishedProducts}}</div>
            <div class="cf-card-label">Published Products</div>
            <div class="cf-card-hint">
              {{#if publishedProducts}}
                Visible to buyers on the storefront.
              {{else}}
                No published products yet.
              {{/if}}
            </div>
          </div>

          <!-- Low Stock (1–5) -->
          <div class="cf-card cf-card--gold">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--gold" aria-hidden="true">⚠️</div>
              <span class="cf-card-badge cf-card-badge--pending">Low Stock</span>
            </div>
            <div class="cf-card-value"
              style="{{#if lowStockProducts}}color:#E65100;{{/if}}">
              {{lowStockProducts}}
            </div>
            <div class="cf-card-label">Low Stock (1–5 units)</div>
            <div class="cf-card-hint">
              {{#if lowStockProducts}}
                <a href="/seller/products" style="color:#E65100;font-weight:600;">Review these products.</a>
              {{else}}
                All products have sufficient stock.
              {{/if}}
            </div>
          </div>

          <!-- Out of Stock (0) -->
          <div class="cf-card cf-card--brown">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--brown" aria-hidden="true">📦</div>
              <span class="cf-card-badge cf-card-badge--neutral">Out of Stock</span>
            </div>
            <div class="cf-card-value"
              style="{{#if outOfStockProducts}}color:#C62828;{{/if}}">
              {{outOfStockProducts}}
            </div>
            <div class="cf-card-label">Out of Stock (0 units)</div>
            <div class="cf-card-hint">
              {{#if outOfStockProducts}}
                <a href="/seller/products" style="color:#C62828;font-weight:600;">Update stock levels.</a>
              {{else}}
                No products are out of stock.
              {{/if}}
            </div>
          </div>

        </div><!-- /.cf-cards -->

        <!-- ── Quick actions ──────────────────────────────────────── -->
        <div class="cf-section-header">
          <span class="cf-section-title">Quick Actions</span>
        </div>
        <div class="cf-quick">
          <a href="/seller/products/add" class="cf-quick-item">
            <span class="cf-quick-icon">➕</span>
            <span class="cf-quick-label">Add Product</span>
          </a>
          <a href="/seller/products" class="cf-quick-item">
            <span class="cf-quick-icon">🏺</span>
            <span class="cf-quick-label">My Products</span>
          </a>
          <a href="/seller/categories" class="cf-quick-item">
            <span class="cf-quick-icon">🗂️</span>
            <span class="cf-quick-label">Categories</span>
          </a>
        </div>

        <!-- ── Recent products ────────────────────────────────────── -->
        <div class="cf-section-header">
          <span class="cf-section-title">Recent Products</span>
          <a href="/seller/products" class="cf-link-btn">View All</a>
        </div>
        <div class="cf-table-card">
          <div class="cf-table-wrap">
            <table class="cf-table" role="table" aria-label="Recent products">
              <thead>
                <tr>
                  <th scope="col">Product</th>
                  <th scope="col">Category</th>
                  <th scope="col">Price</th>
                  <th scope="col">Stock</th>
                  <th scope="col">Status</th>
                  <th scope="col">Date Added</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#if recentProducts.length}}
                  {{#each recentProducts}}
                  <tr>
                    <td>
                      <div class="cf-product-cell">
                        <img
                          src="{{#if this.imagePath}}/{{this.imagePath}}{{else}}/uploads/products/placeholder.svg{{/if}}"
                          alt="{{this.name}}"
                          width="38" height="38"
                          style="width:38px;height:38px;border-radius:8px;object-fit:cover;border:1px solid var(--cream-dark);flex-shrink:0;background:var(--cream-dark);"
                          onerror="this.src='/uploads/products/placeholder.svg';this.onerror=null;"
                        />
                        <div>
                          <div class="cf-product-name">{{this.name}}</div>
                          <div class="cf-product-sku">{{this.sku}}</div>
                        </div>
                      </div>
                    </td>
                    <td style="font-size:13px;color:var(--text-mid);">{{this.category}}</td>
                    <td style="font-weight:600;color:var(--brown);">{{formatPrice this.price}}</td>
                    <td>
                      {{#if (eq this.stock 0)}}
                        <span style="color:#C62828;font-weight:700;font-size:13px;">Out of stock</span>
                      {{else}}
                        <span style="font-size:13px;">{{this.stock}}</span>
                      {{/if}}
                    </td>
                    <td>
                      <span class="cf-status cf-status--{{this.statusClass}}">{{this.status}}</span>
                    </td>
                    <td style="font-size:12px;color:var(--text-muted);white-space:nowrap;">
                      {{formatDate this.createdAt}}
                    </td>
                    <td>
                      <div class="cf-action-group">
                        <a href="/seller/products/edit/{{this.id}}" class="cf-action-btn" aria-label="Edit {{this.name}}" title="Edit">✏️</a>
                        <button
                          type="button"
                          class="cf-action-btn"
                          aria-label="Delete {{this.name}}"
                          title="Delete"
                          onclick="cfConfirmDelete({{this.id}}, '{{this.name}}')"
                          style="background:none;border:1px solid var(--cream-dark);cursor:pointer;"
                        >🗑️</button>
                      </div>
                    </td>
                  </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="7">
                      <div class="cf-table-empty">
                        <div class="cf-table-empty-icon" aria-hidden="true">🏺</div>
                        <p class="cf-table-empty-msg">No products yet</p>
                        <p class="cf-table-empty-hint">
                          <a href="/seller/products/add" style="color:var(--terra);font-weight:600;">Add your first cultural product</a> to get started.
                        </p>
                      </div>
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- ── Delete confirmation modal ──────────────────────────── -->
        <div
          id="cfDeleteModal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="cfDeleteTitle"
          style="display:none;position:fixed;inset:0;z-index:500;align-items:center;justify-content:center;"
        >
          <div
            id="cfDeleteBackdrop"
            style="position:absolute;inset:0;background:rgba(10,46,10,0.55);"
            onclick="cfCloseDelete()"
          ></div>
          <div style="position:relative;z-index:501;background:#fff;border-radius:16px;padding:32px 28px;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(10,46,10,0.25);">
            <div style="width:52px;height:52px;background:#E8F5E9;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 16px;">🗑️</div>
            <h2 id="cfDeleteTitle" style="font-size:18px;font-weight:800;color:#0A2E0A;text-align:center;margin:0 0 8px;">Delete Product?</h2>
            <p style="font-size:13px;color:#558B2F;text-align:center;margin:0 0 6px;">You are about to delete:</p>
            <p id="cfDeleteProductName" style="font-size:14px;font-weight:700;color:#1B5E20;text-align:center;margin:0 0 20px;padding:8px 12px;background:#E8F5E9;border-radius:8px;"></p>
            <p style="font-size:12px;color:#558B2F;text-align:center;margin:0 0 24px;">This action cannot be undone.</p>
            <form id="cfDeleteForm" method="POST" action="">
              <div style="display:flex;gap:12px;justify-content:center;">
                <button type="submit" id="cfDeleteConfirmBtn"
                  style="background:#C62828;color:#fff;border:none;border-radius:8px;padding:10px 28px;font-size:14px;font-weight:700;cursor:pointer;min-width:120px;">
                  Yes, Delete
                </button>
                <button type="button" onclick="cfCloseDelete()"
                  style="background:#E8F5E9;color:#1B5E20;border:none;border-radius:8px;padding:10px 24px;font-size:14px;font-weight:600;cursor:pointer;">
                  Cancel
                </button>
              </div>
            </form>
          </div>
        </div>

        <script>
        function cfConfirmDelete(id, name) {
          document.getElementById('cfDeleteProductName').textContent = name;
          document.getElementById('cfDeleteForm').action = '/seller/products/delete/' + id;
          var modal = document.getElementById('cfDeleteModal');
          modal.style.display = 'flex';
          setTimeout(function() { document.getElementById('cfDeleteConfirmBtn').focus(); }, 50);
        }
        function cfCloseDelete() {
          document.getElementById('cfDeleteModal').style.display = 'none';
          document.getElementById('cfDeleteForm').action = '';
        }
        document.addEventListener('keydown', function(e) { if (e.key === 'Escape') cfCloseDelete(); });
        </script>

{{> seller-footer}}
