{{> seller-head}}
<body>
  <div class="cf-shell">
    {{> seller-sidebar}}
    <div class="cf-main">
      {{> seller-topbar}}
      <main class="cf-page">

        <!-- Page header -->
        <div class="cf-page-header">
          <div class="cf-page-header-inner">
            <div>
              <p class="cf-page-eyebrow">Seller Dashboard</p>
              <h1 class="cf-page-title">Overview</h1>
              <p class="cf-page-sub">Your product management summary</p>
            </div>
          </div>
          <div class="cf-weave-divider" aria-hidden="true"></div>
        </div>

        <!-- Welcome banner -->
        <div class="cf-welcome">
          <div class="cf-welcome-art" aria-hidden="true">🏺</div>
          <div class="cf-welcome-content">
            <h2 class="cf-welcome-title">Welcome to your Seller Dashboard</h2>
            <p class="cf-welcome-sub">
              Manage your cultural heritage products for the Mansalay community marketplace.
            </p>
            <div class="cf-welcome-chips">
              <span class="cf-chip">🏛️ Cultural Heritage</span>
              <span class="cf-chip">🌿 Mansalay, Oriental Mindoro</span>
              <span class="cf-chip">🧵 Traditional Crafts</span>
            </div>
          </div>
        </div>

        <!-- Summary cards -->
        <div class="cf-cards">
          <div class="cf-card cf-card--terra">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--terra" aria-hidden="true">🏺</div>
              <span class="cf-card-badge cf-card-badge--info">Products</span>
            </div>
            <div class="cf-card-value">—</div>
            <div class="cf-card-label">Total Products</div>
            <div class="cf-card-hint">No data yet. Add your first product.</div>
          </div>

          <div class="cf-card cf-card--green">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--green" aria-hidden="true">✅</div>
              <span class="cf-card-badge cf-card-badge--ok">Active</span>
            </div>
            <div class="cf-card-value">—</div>
            <div class="cf-card-label">Active Listings</div>
            <div class="cf-card-hint">Products currently visible to buyers.</div>
          </div>

          <div class="cf-card cf-card--brown">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--brown" aria-hidden="true">🗂️</div>
              <span class="cf-card-badge cf-card-badge--neutral">Categories</span>
            </div>
            <div class="cf-card-value">—</div>
            <div class="cf-card-label">Categories Used</div>
            <div class="cf-card-hint">Distinct categories across listings.</div>
          </div>

          <div class="cf-card cf-card--gold">
            <div class="cf-card-top">
              <div class="cf-card-icon cf-card-icon--gold" aria-hidden="true">⏳</div>
              <span class="cf-card-badge cf-card-badge--pending">Pending</span>
            </div>
            <div class="cf-card-value">—</div>
            <div class="cf-card-label">Pending Review</div>
            <div class="cf-card-hint">Products awaiting admin approval.</div>
          </div>
        </div>

        <!-- Quick actions -->
        <div class="cf-section-header">
          <span class="cf-section-title">Quick Actions</span>
        </div>
        <div class="cf-quick">
          <a href="/seller/products/add" class="cf-quick-item">
            <span class="cf-quick-icon">➕</span>
            <span class="cf-quick-label">Add Product</span>
          </a>
          <a href="/seller/products" class="cf-quick-item">
            <span class="cf-quick-icon">🏺</span>
            <span class="cf-quick-label">My Products</span>
          </a>
          <a href="/seller/categories" class="cf-quick-item">
            <span class="cf-quick-icon">🗂️</span>
            <span class="cf-quick-label">Categories</span>
          </a>
        </div>

        <!-- Recent products -->
        <div class="cf-section-header">
          <span class="cf-section-title">Recent Products</span>
          <a href="/seller/products" class="cf-link-btn">View All</a>
        </div>
        <div class="cf-table-card">
          <div class="cf-table-wrap">
            <table class="cf-table" role="table" aria-label="Recent products">
              <thead>
                <tr>
                  <th scope="col">Product</th>
                  <th scope="col">Category</th>
                  <th scope="col">Status</th>
                  <th scope="col">Date Added</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#if recentProducts.length}}
                  {{#each recentProducts}}
                  <tr>
                    <td>
                      <div class="cf-product-cell">
                        <div class="cf-product-thumb" aria-hidden="true">🏺</div>
                        <div>
                          <div class="cf-product-name">{{this.name}}</div>
                          <div class="cf-product-sku">SKU: {{this.sku}}</div>
                        </div>
                      </div>
                    </td>
                    <td>{{this.category}}</td>
                    <td><span class="cf-status cf-status--{{this.statusClass}}">{{this.status}}</span></td>
                    <td>{{this.dateAdded}}</td>
                    <td>
                      <div class="cf-action-group">
                        <a href="/seller/products/edit/{{this.id}}" class="cf-action-btn" aria-label="Edit {{this.name}}" title="Edit">✏️</a>
                        <a href="/seller/products/delete/{{this.id}}" class="cf-action-btn" aria-label="Delete {{this.name}}" title="Delete">🗑️</a>
                      </div>
                    </td>
                  </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="5">
                      <div class="cf-table-empty">
                        <div class="cf-table-empty-icon" aria-hidden="true">🏺</div>
                        <p class="cf-table-empty-msg">No products yet</p>
                        <p class="cf-table-empty-hint">
                          Start by <a href="/seller/products/add" style="color:var(--terra);font-weight:600;">adding your first cultural product</a>.
                        </p>
                      </div>
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>

{{> seller-footer}}
