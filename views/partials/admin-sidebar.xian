<aside class="cf-admin-sidebar">
  <div class="cf-admin-brand">
    <a href="/admin/dashboard" class="cf-brand">
      <span class="cf-brand-mark"><img src="/images/logo.png" alt="" /></span>
      <span class="cf-brand-copy"><strong>CultureFrame</strong><span>Control center</span></span>
    </a>
  </div>

  <nav class="cf-admin-nav" aria-label="Administrator navigation">
    <p class="cf-admin-label">Overview</p>
    <a href="/admin/dashboard" class="cf-admin-link {{#if (eq activePage 'dashboard')}}active{{/if}}">
      <i class="fas fa-table-cells-large"></i> Control center
    </a>

    <p class="cf-admin-label">Operations</p>
    <a href="/admin/orders" class="cf-admin-link {{#if (eq activePage 'orders')}}active{{/if}}">
      <i class="fas fa-box"></i> Orders
    </a>
    <a href="/admin/feedbacks" class="cf-admin-link {{#if (eq activePage 'feedbacks')}}active{{/if}}">
      <i class="fas fa-star"></i> Feedback
    </a>

    <p class="cf-admin-label">People</p>
    <a href="/admin/sellers" class="cf-admin-link {{#if (eq activePage 'sellers')}}active{{/if}}">
      <i class="fas fa-store"></i> Seller accounts
    </a>
    <a href="/admin/customers" class="cf-admin-link {{#if (eq activePage 'customers')}}active{{/if}}">
      <i class="fas fa-users"></i> Customers
    </a>

    <p class="cf-admin-label">Content & intelligence</p>
    <a href="/visitor/access?returnTo=%2Fadmin%2Fdashboard" class="cf-admin-link external">
      <i class="fas fa-compass"></i> Visitor content
    </a>
    {{#if cultureMetricsSystemUrl}}
      <a href="/admin/analytics/business" class="cf-admin-link external">
        <i class="fas fa-chart-line"></i> CultureMetrics
      </a>
    {{/if}}

    <p class="cf-admin-label">Portal</p>
    <a href="/" class="cf-admin-link"><i class="fas fa-arrow-up-right-from-square"></i> View main site</a>
  </nav>

  <div class="cf-admin-footer">
    <a href="/logout" class="cf-admin-link"><i class="fas fa-arrow-right-from-bracket"></i> Sign out</a>
  </div>
</aside>
