<nav class="cf-nav" id="siteNav" aria-label="Primary navigation">
  <div class="cf-shell">
    <div class="cf-nav-row">
      <a href="/" class="cf-brand" aria-label="CultureFrame home">
        <span class="cf-brand-mark"><img src="/images/logo.png" alt="" /></span>
        <span class="cf-brand-copy">
          <strong>CultureFrame</strong>
          <span>One cultural ecosystem</span>
        </span>
      </a>

      <div class="cf-nav-links" aria-label="Main links">
        <a href="/" class="cf-nav-link"><i class="fas fa-house"></i> Home</a>
        <a href="/discover" class="cf-nav-link"><i class="fas fa-compass"></i> Discover</a>
        <a href="/shop" class="cf-nav-link"><i class="fas fa-store"></i> Marketplace</a>
      </div>

      <div class="cf-nav-actions">
        <a href="/discover/search" class="cf-nav-icon" aria-label="Search visitor information" title="Search">
          <i class="fas fa-magnifying-glass"></i>
        </a>
        {{#if isLoggedIn}}
          <a href="/cart" class="cf-nav-icon" aria-label="Shopping cart" title="Cart">
            <i class="fas fa-bag-shopping"></i>
            {{#if cartCount}}<span class="sr-only">{{cartCount}} items</span>{{/if}}
          </a>
          {{#if (eq sessionUserRole 'admin')}}
            <a href="/admin/dashboard" class="cf-nav-user" title="Open administration">
          {{else}}
            {{#if (eq sessionUserRole 'seller')}}
              <a href="/seller/dashboard" class="cf-nav-user" title="Open seller workspace">
            {{else}}
              <a href="/customer/dashboard" class="cf-nav-user" title="Open your dashboard">
            {{/if}}
          {{/if}}
              <span class="cf-nav-avatar">{{#if user.name}}{{user.name.[0]}}{{else}}U{{/if}}</span>
              <span>{{user.name}}</span>
            </a>
          <a href="/logout" class="cf-nav-icon" aria-label="Sign out" title="Sign out"><i class="fas fa-arrow-right-from-bracket"></i></a>
        {{else}}
          <a href="/login" class="cf-nav-link">Sign in</a>
          <a href="/register" class="cf-nav-cta">Join CultureFrame <i class="fas fa-arrow-right"></i></a>
        {{/if}}
        <button id="mobileMenuButton" class="cf-menu-toggle" type="button" aria-expanded="false" aria-controls="mobileMenu" aria-label="Open menu">
          <i class="fas fa-bars"></i>
        </button>
      </div>
    </div>

    <div id="mobileMenu" class="cf-mobile-menu">
      <a href="/" class="cf-mobile-link"><i class="fas fa-house"></i> Home</a>
      <a href="/discover" class="cf-mobile-link"><i class="fas fa-compass"></i> Discover culture</a>
      <a href="/shop" class="cf-mobile-link"><i class="fas fa-store"></i> Marketplace</a>
      <a href="/discover/search" class="cf-mobile-link"><i class="fas fa-magnifying-glass"></i> Search</a>
      {{#if isLoggedIn}}
        <a href="/dashboard" class="cf-mobile-link"><i class="fas fa-table-cells-large"></i> My workspace</a>
        <a href="/logout" class="cf-mobile-link"><i class="fas fa-arrow-right-from-bracket"></i> Sign out</a>
      {{else}}
        <a href="/login" class="cf-mobile-link"><i class="fas fa-right-to-bracket"></i> Sign in</a>
      {{/if}}
    </div>
  </div>
</nav>

<script>
  (() => {
    const nav = document.getElementById('siteNav');
    const button = document.getElementById('mobileMenuButton');
    const menu = document.getElementById('mobileMenu');
    const syncNav = () => nav && nav.classList.toggle('is-scrolled', window.scrollY > 8);
    syncNav();
    window.addEventListener('scroll', syncNav, { passive: true });
    if (button && menu) {
      button.addEventListener('click', () => {
        const open = menu.classList.toggle('is-open');
        button.setAttribute('aria-expanded', String(open));
        button.querySelector('i').className = open ? 'fas fa-xmark' : 'fas fa-bars';
      });
    }
  })();
</script>
