{{>head}}
<body class="bg-gray-50">
  {{>nav}}

  <div class="max-w-5xl mx-auto px-4 py-8">
    <!-- Back -->
    <a href="/heritage" class="inline-flex items-center gap-2 text-emerald-600 hover:text-emerald-700 font-semibold text-sm mb-6 transition-colors cf-fade-up">
      <i class="fas fa-arrow-left"></i> Back to Heritage Sites
    </a>

    <!-- Main card -->
    <div class="cf-card overflow-hidden cf-fade-up">
      <!-- Hero image -->
      <div class="relative h-72 md:h-96 overflow-hidden bg-emerald-100">
        <img src="{{heritage.image_url}}" alt="{{heritage.title}}"
             class="w-full h-full object-cover"
             onerror="this.src='/images/logo.png'" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>
        <div class="absolute bottom-5 left-6 right-6 flex flex-wrap items-end justify-between gap-3">
          <div>
            <span class="cf-badge cf-badge-green capitalize mb-2 block w-fit">{{heritage.category}}</span>
            <h1 class="text-2xl md:text-3xl font-extrabold text-white leading-tight">{{heritage.title}}</h1>
          </div>
          <div class="flex items-center gap-1.5 text-white text-sm bg-black/40 px-3 py-1.5 rounded-lg backdrop-blur-sm flex-shrink-0">
            <i class="fas fa-map-marker-alt text-emerald-400"></i>
            <span>{{heritage.location}}</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-6 md:p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Main text -->
          <div class="md:col-span-2 space-y-6">
            <div>
              <h2 class="cf-section-title mb-3 text-base">About this Site</h2>
              <p class="text-gray-700 leading-relaxed">{{heritage.description}}</p>
            </div>
            {{#if heritage.historical_significance}}
            <div>
              <h2 class="cf-section-title mb-3 text-base">Historical Significance</h2>
              <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-5">
                <p class="text-gray-700 leading-relaxed">{{heritage.historical_significance}}</p>
              </div>
            </div>
            {{/if}}

            <!-- ── 3D MAP SECTION ───────────────────────────────── -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <h2 class="cf-section-title text-base">Location Map</h2>
                <div class="flex gap-2">
                  <button id="btn2d" onclick="switchTo2D()"
                    class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-emerald-100 transition-colors">
                    <i class="fas fa-map"></i> 2D
                  </button>
                  <button id="btn3d" onclick="switchTo3D()"
                    class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition-colors">
                    <i class="fas fa-cube"></i> 3D
                  </button>
                </div>
              </div>

              <!-- 2D Leaflet map (hidden by default) -->
              <div id="map2d" class="rounded-xl overflow-hidden border border-emerald-100 hidden" style="height:320px;"></div>

              <!-- 3D Cesium map (shown by default) -->
              <div id="map3d" class="rounded-xl overflow-hidden border border-emerald-100" style="height:320px;">
                <iframe id="map3dFrame"
                  width="100%" height="100%"
                  style="border:0; border-radius:12px;"
                  loading="lazy"
                  allowfullscreen
                  referrerpolicy="no-referrer-when-downgrade"
                  src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d3000!2d121.4267!3d12.5213!2m3!1f0!2f45!3f0!3m2!1i1024!2i768!4f13.1!5e1!3m2!1sen!2sph!4v1699999999999!5m2!1sen!2sph">
                </iframe>
              </div>

              <p class="text-xs text-gray-400 mt-2 flex items-center gap-1">
                <i class="fas fa-info-circle text-emerald-400"></i>
                Switch to <strong>3D</strong> for an immersive terrain view of this heritage site.
              </p>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="space-y-4">
            <div class="cf-card-green p-5">
              <h3 class="font-bold text-gray-800 mb-3 text-sm">Site Details</h3>
              <div class="space-y-3">
                <div class="flex items-start gap-2.5">
                  <i class="fas fa-tag text-emerald-600 mt-0.5 text-xs w-4"></i>
                  <div>
                    <p class="text-xs text-gray-400">Category</p>
                    <p class="text-sm font-semibold text-gray-700 capitalize">{{heritage.category}}</p>
                  </div>
                </div>
                <div class="flex items-start gap-2.5">
                  <i class="fas fa-map-marker-alt text-emerald-600 mt-0.5 text-xs w-4"></i>
                  <div>
                    <p class="text-xs text-gray-400">Location</p>
                    <p class="text-sm font-semibold text-gray-700">{{heritage.location}}</p>
                  </div>
                </div>
                {{#if heritage.year_established}}
                <div class="flex items-start gap-2.5">
                  <i class="fas fa-calendar text-emerald-600 mt-0.5 text-xs w-4"></i>
                  <div>
                    <p class="text-xs text-gray-400">Year Established</p>
                    <p class="text-sm font-semibold text-gray-700">{{heritage.year_established}}</p>
                  </div>
                </div>
                {{/if}}
              </div>
            </div>

            <!-- CTA -->
            <div class="cf-page-header p-5 text-center" style="border-radius:12px;padding:1.25rem;">
              <i class="fas fa-compass text-2xl text-white mb-2"></i>
              <p class="text-white font-bold text-sm mb-3">Explore More</p>
              <a href="/heritage" class="cf-btn bg-white text-emerald-700 hover:bg-emerald-50 w-full justify-center text-xs">
                All Heritage Sites
              </a>
            </div>
          </div>
        </div>

        <!-- ── RELATED PRODUCTS ─────────────────────────────── -->
        {{#if relatedProducts.length}}
        <div class="mt-8 pt-6 border-t border-gray-100">
          <div class="flex items-center justify-between mb-5">
            <h2 class="cf-section-title text-base">Products from this Heritage Site</h2>
            <a href="/shop" class="text-xs text-emerald-600 hover:text-emerald-700 font-semibold">
              View all products →
            </a>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
            {{#each relatedProducts}}
            <a href="/shop/product/{{this.id}}" class="group cf-card overflow-hidden hover:shadow-md transition-all">
              <div class="h-28 overflow-hidden bg-gray-100">
                <img src="{{this.image_url}}" alt="{{this.name}}"
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                     onerror="this.src='/images/logo.png'" />
              </div>
              <div class="p-2.5">
                <p class="text-xs font-semibold text-gray-800 line-clamp-2 group-hover:text-emerald-600 transition-colors">{{this.name}}</p>
                <p class="text-sm font-extrabold text-emerald-600 mt-1">₱{{this.price}}</p>
              </div>
            </a>
            {{/each}}
          </div>
        </div>
        {{/if}}

        <!-- Related heritage -->
        {{#if relatedHeritage.length}}
        <div class="mt-8 pt-6 border-t border-gray-100">
          <h2 class="cf-section-title mb-5 text-base">Related Heritage Sites</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {{#each relatedHeritage}}
            <a href="/heritage/{{this.id}}" class="group cf-card overflow-hidden hover:shadow-md transition-all">
              <img src="{{this.image_url}}" alt="{{this.title}}"
                   class="w-full h-32 object-cover group-hover:scale-105 transition-transform duration-300"
                   onerror="this.src='/images/logo.png'" />
              <div class="p-3">
                <h4 class="font-semibold text-gray-800 text-sm group-hover:text-emerald-600 transition-colors line-clamp-1">{{this.title}}</h4>
                <p class="text-xs text-gray-400 mt-0.5 flex items-center gap-1">
                  <i class="fas fa-map-marker-alt"></i> {{this.location}}
                </p>
              </div>
            </a>
            {{/each}}
          </div>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  {{>footer}}

  <!-- Leaflet (2D) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    // ── Coordinates from server ───────────────────────────────
    // Heritage has no lat/lng stored — we geocode from location name
    const HERITAGE_LOCATION = "{{heritage.location}}, Mansalay, Oriental Mindoro";
    const MANSALAY_CENTER   = [12.5833, 121.4500];
    let   cesiumLoaded      = false;
    let   leafletMap        = null;

    // ── 2D Leaflet map ────────────────────────────────────────
    function init2DMap(lat, lng) {
      const center = (lat && lng) ? [lat, lng] : MANSALAY_CENTER;
      const zoom   = (lat && lng) ? 15 : 12;

      leafletMap = L.map('map2d').setView(center, zoom);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors'
      }).addTo(leafletMap);

      if (lat && lng) {
        const icon = L.divIcon({
          className: '',
          html: `<div style="background:linear-gradient(135deg,#059669,#10b981);width:36px;height:36px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid white;box-shadow:0 4px 10px rgba(0,0,0,.3);display:flex;align-items:center;justify-content:center;">
                   <i class="fas fa-landmark" style="transform:rotate(45deg);color:white;font-size:14px;"></i>
                 </div>`,
          iconSize:   [36, 36],
          iconAnchor: [18, 36],
          popupAnchor:[0, -40]
        });
        L.marker([lat, lng], { icon }).addTo(leafletMap)
          .bindPopup(`<b style="color:#059669">${HERITAGE_LOCATION}</b>`)
          .openPopup();
      }
    }

    // Geocode the heritage location string
    async function geocodeLocation() {
      try {
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(HERITAGE_LOCATION)}&limit=1`;
        const res  = await fetch(url, { headers: { 'Accept-Language': 'en' } });
        const data = await res.json();
        if (data && data.length) {
          return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
        }
      } catch(e) {}
      return null;
    }

    // ── 3D Google Maps satellite tilt view ───────────────────
    function load3DMap(lat, lng) {
      if (cesiumLoaded) return;
      cesiumLoaded = true;

      const targetLat = lat || MANSALAY_CENTER[0];
      const targetLng = lng || MANSALAY_CENTER[1];

      // Google Maps Embed — satellite with 45° 3D tilt
      // !5e1 = satellite imagery, !2f45 = 45° tilt
      const embedUrl = `https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d2000!2d${targetLng}!3d${targetLat}!2m3!1f0!2f45!3f0!3m2!1i1024!2i768!4f13.1!5e1!3m2!1sen!2sph!4v1699999999999!5m2!1sen!2sph`;

      const frame = document.getElementById('map3dFrame');
      if (frame) frame.src = embedUrl;
    }

    // ── Toggle buttons ────────────────────────────────────────
    let resolvedCoords = null;

    function switchTo2D() {
      document.getElementById('map2d').classList.remove('hidden');
      document.getElementById('map3d').classList.add('hidden');
      document.getElementById('btn2d').className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition-colors';
      document.getElementById('btn3d').className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-emerald-100 transition-colors';
      if (leafletMap) leafletMap.invalidateSize();
    }

    function switchTo3D() {
      document.getElementById('map2d').classList.add('hidden');
      document.getElementById('map3d').classList.remove('hidden');
      document.getElementById('btn3d').className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-emerald-600 text-white transition-colors';
      document.getElementById('btn2d').className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-100 text-gray-600 hover:bg-emerald-100 transition-colors';
      const c = resolvedCoords;
      load3DMap(c ? c.lat : null, c ? c.lng : null);
    }

    // ── Init on load ──────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', async () => {
      const coords = await geocodeLocation();
      resolvedCoords = coords;
      init2DMap(coords ? coords.lat : null, coords ? coords.lng : null);
      // Load 3D immediately (default view)
      load3DMap(coords ? coords.lat : null, coords ? coords.lng : null);
    });
  </script>
</body>
</html>
