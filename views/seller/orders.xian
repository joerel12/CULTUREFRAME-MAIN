{{>head}}
<body class="bg-gray-50">
  <div class="min-h-screen lg:flex">
    {{> seller-sidebar}}
    <main class="flex-1 p-5 lg:p-8">
      <div class="mx-auto max-w-7xl">
        <header class="mb-7 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-bold uppercase tracking-widest text-emerald-700">Seller workspace</p><h1 class="mt-1 text-3xl font-extrabold text-gray-900">Transactions & payments</h1><p class="mt-2 text-gray-600">Only orders containing your products appear here. Amounts are for your items.</p></div><a href="/seller/walk-in" class="cf-btn cf-btn-primary"><i class="fas fa-plus"></i>Record walk-in sale</a></header>
        {{#if success_msg}}<div class="mb-5 rounded-xl bg-emerald-100 px-4 py-3 text-emerald-800">{{success_msg}}</div>{{/if}}
        {{#if error_msg}}<div class="mb-5 rounded-xl bg-red-100 px-4 py-3 text-red-800">{{error_msg}}</div>{{/if}}
        <nav class="mb-5 flex flex-wrap gap-2" aria-label="Transaction type"><a href="/seller/orders" class="cf-btn {{#if (eq channel 'all')}}cf-btn-primary{{else}}cf-btn-outline{{/if}}">All</a><a href="/seller/orders?channel=online" class="cf-btn {{#if (eq channel 'online')}}cf-btn-primary{{else}}cf-btn-outline{{/if}}">Online orders</a><a href="/seller/orders?channel=walk-in" class="cf-btn {{#if (eq channel 'walk-in')}}cf-btn-primary{{else}}cf-btn-outline{{/if}}">Walk-in sales</a></nav>
        <div class="cf-card overflow-x-auto"><table class="min-w-full divide-y divide-gray-100 text-sm"><thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500"><tr><th class="px-5 py-4">Transaction</th><th class="px-5 py-4">Customer</th><th class="px-5 py-4">Your items</th><th class="px-5 py-4">Your subtotal</th><th class="px-5 py-4">Payment</th><th class="px-5 py-4">Order</th><th class="px-5 py-4">Details</th></tr></thead><tbody class="divide-y divide-gray-100">{{#each orders}}<tr><td class="px-5 py-4"><a class="font-bold text-emerald-800 hover:underline" href="/seller/orders/{{id}}">#{{id}}</a><p class="mt-1 text-xs text-gray-500">{{dateLabel}}</p><span class="mt-1 inline-block text-xs font-semibold text-gray-600">{{#if isWalkIn}}Walk-in{{else}}Online{{/if}}</span></td><td class="px-5 py-4 font-semibold text-gray-800">{{customer_name}}</td><td class="px-5 py-4">{{itemCount}}</td><td class="px-5 py-4 font-bold text-emerald-800">PHP {{subtotal}}</td><td class="px-5 py-4"><span class="cf-badge {{#if (eq paymentStatus 'paid')}}cf-badge-green{{else}}cf-badge-amber{{/if}}">{{paymentStatus}}</span></td><td class="px-5 py-4 capitalize">{{status}}</td><td class="px-5 py-4"><a href="/seller/orders/{{id}}" class="text-sm font-bold text-emerald-700 hover:underline">View receipt & payments</a></td></tr>{{else}}<tr><td colspan="7" class="px-5 py-14 text-center text-gray-500">No transactions in this view yet.</td></tr>{{/each}}</tbody></table></div>
        {{#if hasOrders}}<div class="mt-5 flex items-center justify-between text-sm text-gray-600"><p>{{totalOrders}} transaction(s) · Page {{currentPage}}</p><div class="flex gap-2">{{#if previousPage}}<a href="/seller/orders?channel={{channel}}&page={{previousPage}}" class="cf-btn cf-btn-outline">Previous</a>{{/if}}{{#if nextPage}}<a href="/seller/orders?channel={{channel}}&page={{nextPage}}" class="cf-btn cf-btn-outline">Next</a>{{/if}}</div></div>{{/if}}
      </div>
    </main>
  </div>
</body>
</html>
