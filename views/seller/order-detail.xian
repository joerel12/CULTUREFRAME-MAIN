{{>head}}
<body class="bg-gray-50">
  <div class="min-h-screen lg:flex">
    {{> seller-sidebar}}
    <main class="flex-1 p-5 lg:p-8">
      <div class="mx-auto max-w-5xl">
        <a href="/seller/orders" class="text-sm font-bold text-emerald-700 hover:underline"><i class="fas fa-arrow-left mr-2"></i>All transactions</a>
        <header class="mt-4 flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-bold uppercase tracking-widest text-emerald-700">{{#if order.isWalkIn}}Walk-in sale{{else}}Online order{{/if}}</p><h1 class="mt-1 text-3xl font-extrabold text-gray-900">Transaction #{{order.id}}</h1><p class="mt-2 text-gray-600">{{order.dateLabel}}</p></div>{{#if order.isWalkIn}}<a href="/seller/walk-in" class="cf-btn cf-btn-primary">Record another sale</a>{{/if}}</header>
        {{#if success_msg}}<div class="mt-5 rounded-xl bg-emerald-100 px-4 py-3 text-emerald-800">{{success_msg}}</div>{{/if}}
        {{#if error_msg}}<div class="mt-5 rounded-xl bg-red-100 px-4 py-3 text-red-800">{{error_msg}}</div>{{/if}}
        <div class="mt-6 grid gap-4 md:grid-cols-3"><div class="cf-card p-5"><p class="text-sm text-gray-500">Your product subtotal</p><p class="mt-2 text-2xl font-extrabold text-emerald-800">PHP {{order.subtotal}}</p><p class="mt-1 text-xs text-gray-500">Other sellers' items are excluded.</p></div><div class="cf-card p-5"><p class="text-sm text-gray-500">Payment status for your items</p><p class="mt-2 text-2xl font-extrabold capitalize text-gray-900">{{order.paymentStatus}}</p><p class="mt-1 text-xs text-gray-500">{{order.payment_method}}</p></div><div class="cf-card p-5"><p class="text-sm text-gray-500">Order status</p><p class="mt-2 text-2xl font-extrabold capitalize text-gray-900">{{order.status}}</p><p class="mt-1 text-xs text-gray-500">{{order.itemCount}} item(s) from your shop</p></div></div>
        <section class="cf-card mt-6 p-5"><h2 class="text-lg font-bold text-gray-900">Customer & fulfillment</h2><dl class="mt-4 grid gap-4 text-sm md:grid-cols-2"><div><dt class="text-gray-500">Name</dt><dd class="font-semibold text-gray-900">{{order.customer_name}}</dd></div>{{#unless order.isWalkIn}}<div><dt class="text-gray-500">Email</dt><dd class="font-semibold text-gray-900">{{order.customer_email}}</dd></div><div><dt class="text-gray-500">Phone</dt><dd class="font-semibold text-gray-900">{{order.customer_phone}}</dd></div><div><dt class="text-gray-500">Delivery address</dt><dd class="font-semibold text-gray-900">{{order.shipping_address}}</dd></div>{{/unless}}</dl></section>
        <section class="cf-card mt-6 overflow-hidden"><div class="border-b px-5 py-4"><h2 class="text-lg font-bold text-gray-900">Your products in this order</h2></div><div class="divide-y">{{#each order.lines}}<div class="flex flex-wrap items-center gap-4 px-5 py-4"><img src="{{#if image_url}}{{image_url}}{{else}}/images/cultureframe-logo.svg{{/if}}" alt="" class="h-14 w-14 rounded-xl border object-cover" /><div class="min-w-0 flex-1"><p class="font-bold text-gray-900">{{product_name}}</p><p class="text-sm text-gray-500">{{quantity}} × PHP {{price}}</p></div><div class="text-right"><p class="font-bold text-emerald-800">PHP {{lineTotal}}</p><p class="text-xs text-gray-500">{{#if paid}}Paid{{else}}Payment pending{{/if}}</p></div></div>{{/each}}</div></section>
        <section class="cf-card mt-6 overflow-hidden">
          <div class="border-b px-5 py-4"><h2 class="text-lg font-bold text-gray-900">Payment records & proof</h2><p class="text-sm text-gray-500">References and receipts from checkout or the payment system. Shared checkout payments cover the entire order.</p></div>
          <div class="divide-y">{{#each order.payments}}
            <div class="px-5 py-5 text-sm">
              <div class="grid gap-3 md:grid-cols-4">
                <div><p class="text-gray-500">Method</p><p class="font-bold text-gray-900">{{method}}</p>{{#if productAmount}}<p class="text-xs text-gray-500">Your product: PHP {{productAmount}}</p>{{else}}<p class="text-xs text-gray-500">Order-level payment</p>{{/if}}</div>
                <div><p class="text-gray-500">Status</p><p class="font-bold capitalize text-gray-900">{{status}}</p></div>
                <div><p class="text-gray-500">Reference</p><p class="break-all font-semibold text-gray-900">{{#if reference_number}}{{reference_number}}{{else}}Not supplied{{/if}}</p></div>
                <div><p class="text-gray-500">Recorded</p><p class="font-semibold text-gray-900">{{dateLabel}}</p>{{#if proofPath}}<a href="{{proofPath}}" target="_blank" rel="noopener" class="mt-2 inline-flex font-bold text-emerald-700 hover:underline"><i class="fas fa-file-image mr-2"></i>Open receipt</a>{{/if}}</div>
              </div>
              {{#if cashTendered}}<p class="mt-3 text-gray-600">Cash tendered: PHP {{cashTendered}} · Change: PHP {{change}}</p>{{/if}}
              {{#if reviewNote}}<p class="mt-3 rounded-lg bg-amber-50 p-3 text-amber-900">Payment review: {{reviewNote}}</p>{{/if}}
            </div>
          {{else}}<p class="px-5 py-8 text-gray-500">No payment record has been submitted. This transaction is still awaiting payment or uses cash on delivery.</p>{{/each}}</div>
        </section>
        {{#if order.isWalkIn}}<p class="mt-4 text-xs text-gray-500">Walk-in payment is recorded by the seller; a GCash reference or receipt is not independent provider verification.</p>{{/if}}
      </div>
    </main>
  </div>
</body>
</html>
