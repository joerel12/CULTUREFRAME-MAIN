{{>head}}
<body class="bg-gray-50">
  <div class="min-h-screen lg:flex">
    {{> seller-sidebar}}
    <main class="flex-1 p-5 lg:p-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-7">
          <p class="text-sm font-semibold text-emerald-600">Point of sale</p>
          <h1 class="text-3xl font-extrabold text-gray-900">Walk-in transaction</h1>
          <p class="mt-1 text-gray-500">Record an in-person cash or GCash sale. A completed sale appears in Transactions and updates stock immediately.</p>
        </div>
        {{#if success_msg}}<div class="mb-5 rounded-xl bg-emerald-100 px-4 py-3 text-emerald-800"><i class="fas fa-circle-check mr-2"></i>{{success_msg}}</div>{{/if}}
        {{#if error_msg}}<div class="mb-5 rounded-xl bg-red-100 px-4 py-3 text-red-800"><i class="fas fa-circle-exclamation mr-2"></i>{{error_msg}}</div>{{/if}}

        <form method="post" action="/seller/walk-in" enctype="multipart/form-data" id="walkInForm" class="grid gap-6 xl:grid-cols-[1fr_360px]">
          <section class="cf-card overflow-hidden">
            <div class="border-b px-5 py-4"><h2 class="font-bold text-gray-900">Select products</h2><p class="text-sm text-gray-500">Enter 1–100 units per product, subject to stock. Prices are taken from the current catalog.</p></div>
            <div class="divide-y">
              {{#each products}}
              <label class="grid grid-cols-[58px_1fr_90px] items-center gap-4 px-5 py-4 hover:bg-emerald-50">
                <img src="{{#if image_url}}{{image_url}}{{else}}/images/cultureframe-logo.svg{{/if}}" alt="" class="h-14 w-14 rounded-xl border object-cover" />
                <span><strong class="block text-gray-900">{{name}}</strong><small class="text-gray-500">PHP {{price}} · {{stocks}} available · {{category}}</small></span>
                <input type="number" name="quantities[{{id}}]" min="0" max="{{walkInLimit}}" step="1" value="0" data-price="{{price}}" aria-label="Quantity for {{name}}" class="w-full rounded-xl border-2 border-emerald-100 p-3 text-center font-bold focus:border-emerald-500" />
              </label>
              {{else}}
              <div class="px-5 py-12 text-center text-gray-500">No active products are currently in stock.</div>
              {{/each}}
            </div>
            <div class="flex items-center justify-between border-t bg-emerald-50 px-5 py-4 text-sm"><span class="font-semibold text-emerald-900">Selected items</span><strong id="walkInCount" class="text-emerald-900">0</strong></div>
          </section>

          <aside class="cf-card h-max p-5 xl:sticky xl:top-5">
            <h2 class="text-xl font-extrabold text-emerald-950">Payment</h2>
            <label class="mt-5 block text-sm font-bold text-gray-700">Customer name (optional)<input name="customer_name" maxlength="120" placeholder="Walk-in Customer" class="mt-2 w-full rounded-xl border-2 border-emerald-100 p-3 focus:border-emerald-500" /></label>
            <label class="mt-4 block text-sm font-bold text-gray-700">Payment method<select name="payment_method" id="walkInPayment" required class="mt-2 w-full rounded-xl border-2 border-emerald-100 bg-white p-3"><option value="cash">Cash</option><option value="gcash">GCash</option></select></label>
            <label id="cashField" class="mt-4 block text-sm font-bold text-gray-700">Cash tendered<input type="number" name="cash_tendered" min="0" step="0.01" inputmode="decimal" class="mt-2 w-full rounded-xl border-2 border-emerald-100 p-3" /><span class="mt-2 block text-xs font-normal text-gray-500">Change: <strong id="walkInChange">PHP 0.00</strong></span></label>
            <div id="gcashField" class="mt-4 hidden space-y-4"><label class="block text-sm font-bold text-gray-700">GCash reference<input name="reference_number" minlength="6" maxlength="100" placeholder="Transaction reference" class="mt-2 w-full rounded-xl border-2 border-emerald-100 p-3" /></label><label class="block text-sm font-bold text-gray-700">GCash receipt (optional)<input type="file" name="payment_proof" accept="image/jpeg,image/png,image/webp" class="mt-2 w-full rounded-xl border-2 border-emerald-100 p-3 text-sm" /><span class="mt-1 block text-xs font-normal text-gray-500">JPEG, PNG, or WebP; up to 5 MB. Visible only to this seller and authorized order viewers.</span></label></div>
            <div class="my-5 flex items-center justify-between border-y py-4"><span class="font-semibold text-gray-600">Total</span><strong id="walkInTotal" class="text-2xl text-emerald-800">PHP 0.00</strong></div>
            <button type="submit" id="walkInSubmit" class="cf-btn cf-btn-primary w-full justify-center"><i class="fas fa-check"></i>Complete paid sale</button>
            <p id="walkInError" class="mt-2 text-sm font-semibold text-red-700" role="alert" aria-live="polite"></p>
            <p class="mt-3 text-xs leading-5 text-gray-500"><i class="fas fa-shield-halved mr-1"></i>The server rechecks stock, seller ownership, prices, and payment before saving.</p>
          </aside>
        </form>
        <section class="cf-card mt-8 overflow-hidden"><div class="flex items-center justify-between border-b px-5 py-4"><div><h2 class="font-bold text-gray-900">Recent walk-in sales</h2><p class="text-sm text-gray-500">Saved transaction receipts</p></div><a href="/seller/orders?channel=walk-in" class="text-sm font-semibold text-emerald-700">View all</a></div><div class="divide-y">{{#each recentWalkIns}}<a href="/seller/orders/{{id}}" class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 hover:bg-emerald-50"><div><p class="font-bold text-gray-900">#{{id}} · {{customer_name}}</p><p class="text-xs text-gray-500">{{dateLabel}} · {{payment_method}}</p></div><strong class="text-emerald-800">PHP {{subtotal}}</strong></a>{{else}}<p class="px-5 py-8 text-center text-gray-500">No walk-in sales recorded yet.</p>{{/each}}</div></section>
      </div>
    </main>
  </div>
  <script>
    (() => {
      const quantities = [...document.querySelectorAll('[data-price]')];
      const total = document.getElementById('walkInTotal');
      const payment = document.getElementById('walkInPayment');
      const cash = document.getElementById('cashField');
      const gcash = document.getElementById('gcashField');
      const count = document.getElementById('walkInCount');
      const change = document.getElementById('walkInChange');
      const error = document.getElementById('walkInError');
      const submit = document.getElementById('walkInSubmit');
      const form = document.getElementById('walkInForm');
      let totalCents = 0;
      const updateTotal = () => {
        totalCents = quantities.reduce((sum, input) => sum + (Number(input.value) || 0) * Math.round(Number(input.dataset.price) * 100), 0);
        const itemCount = quantities.reduce((sum, input) => sum + (Number(input.value) || 0), 0);
        total.textContent = `PHP ${(totalCents / 100).toFixed(2)}`;
        count.textContent = String(itemCount);
        const tenderedCents = Math.round(Number(cash.querySelector('input').value || 0) * 100);
        change.textContent = `PHP ${(Math.max(0, tenderedCents - totalCents) / 100).toFixed(2)}`;
        submit.disabled = itemCount < 1;
        submit.classList.toggle('opacity-50', itemCount < 1);
        error.textContent = '';
      };
      const updateMethod = () => {
        const usesGcash = payment.value === 'gcash';
        cash.classList.toggle('hidden', usesGcash);
        gcash.classList.toggle('hidden', !usesGcash);
        cash.querySelector('input').required = !usesGcash;
        gcash.querySelector('input').required = usesGcash;
        if (!usesGcash) gcash.querySelector('input[type=file]').value = '';
      };
      quantities.forEach(input => input.addEventListener('input', updateTotal));
      cash.querySelector('input').addEventListener('input', updateTotal);
      payment.addEventListener('change', updateMethod);
      form.addEventListener('submit', event => {
        if (totalCents < 1) {
          event.preventDefault();
          error.textContent = 'Choose at least one product.';
          return;
        }
        if (payment.value === 'cash' && Math.round(Number(cash.querySelector('input').value) * 100) < totalCents) {
          event.preventDefault();
          error.textContent = 'Cash tendered must cover the total.';
          return;
        }
        submit.disabled = true;
        submit.textContent = 'Saving transaction…';
      });
      updateMethod(); updateTotal();
    })();
  </script>
</body>
</html>
