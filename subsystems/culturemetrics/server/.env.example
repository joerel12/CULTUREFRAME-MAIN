NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL is optional for development + mock mode; leave blank for ephemeral demo mode.
# Leave blank for local development + mock mode; fallback uses process memory.
DATABASE_URL=

# Development + mock mode generates process-local secrets; persistent mode requires unique values.
# In development mock mode, omitted values are generated for this process.
SESSION_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Local demo defaults are development-only; normal PostgreSQL mode requires explicit bootstrap setup.
# Development-only ephemeral demo credentials; normal DB mode requires explicit setup.
ADMIN_BOOTSTRAP_USERNAME=demo-admin
ADMIN_BOOTSTRAP_EMAIL=demo-admin@culturemetrics.local
ADMIN_BOOTSTRAP_PASSWORD=DemoPassword123!

# CultureFrame integration
CULTUREFRAME_SSO_SECRET=replace-with-the-same-random-32-character-secret-used-by-the-main-system
CULTUREFRAME_API_URL=https://jennycultureframe-1.onrender.com
CULTUREFRAME_API_TOKEN=
CULTUREFRAME_API_TIMEOUT_MS=15000
CULTUREFRAME_INTEGRATION_ENABLED=false

# Data mode: "mock" (fictional demo records) | "live" (CultureFrame API)
CULTUREMETRICS_DATA_MODE=mock
